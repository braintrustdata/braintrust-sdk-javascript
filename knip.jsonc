{
  "$schema": "node_modules/knip/schema-jsonc.json",
  "include": ["files", "exports", "types"],
  "ignoreFiles": [
    ".context/**",
    ".changeset/changelog.cjs",
    "integrations/otel-js/otel-v1/**",
    "integrations/otel-js/otel-v2/**",
    "integrations/val.town/vals/tutorial/code.ts",
  ],
  "ignoreIssues": {
    "**/generated*_types.ts": ["files", "exports", "types"],
  },
  "workspaces": {
    "dev-packages/seinfeld": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
    "e2e": {
      "entry": [
        "package.json",
        "vite.config.ts",
        "helpers/**/*.ts",
        "scenarios/**/*.test.ts",
        "scenarios/**/package.json",
        "scenarios/**/*.ts",
        "scenarios/**/*.mjs",
      ],
      "project": [
        "helpers/**/*.ts",
        "scenarios/**/*.test.ts",
        "scenarios/**/package.json",
        "scenarios/**/*.ts",
        "scenarios/**/*.mjs",
      ],
      "ignore": ["runScenarioDir", "runNodeScenarioDir"],
      "ignoreFiles": [
        "helpers/scenario-runtime.ts",
        "scenarios/**/scenario.ts",
        "scenarios/**/scenario.mjs",
        "scenarios/**/scenario.*.ts",
        "scenarios/**/scenario.*.mjs",
      ],
      "ignoreDependencies": ["openai", "openai-v4", "openai-v5"],
    },
    "js": {
      "entry": [
        "src/node/index.ts",
        "src/exports.ts",
        "src/auto.ts",
        "src/auto-instrumentations/{index.ts,hook.mts,loader/module-hooks.mts}",
        "src/{node,non-node}/apply-auto-instrumentation-entry.ts",
        "src/{node,browser,workerd,edge-light}/{isomorph,config}.ts",
        "src/{custom-views,preprocessors}/exports.ts",
        "src/browser/index.ts",
        "src/edge-light/index.ts",
        "src/workerd/index.ts",
        "src/instrumentation/index.ts",
        "src/auto-instrumentations/bundler/*.ts",
        "tests/**/*.{ts,tsx,mts,cts,cjs,mjs}",
        "scripts/**/*.{ts,mjs}",
        "examples/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "smoke/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "util/**/*.ts",
      ],
      "project": [
        "src/**/*.{ts,tsx,mts,cts}",
        "tests/**/*.{ts,tsx,mts,cts,cjs,mjs}",
        "scripts/**/*.{ts,mjs}",
        "examples/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "smoke/**/*.{ts,tsx,js,jsx,mjs,cjs,d.ts}",
        "util/**/*.ts",
      ],
    },
    "js/src/wrappers/claude-agent-sdk": {
      "entry": ["*.test.ts"],
      "project": ["*.ts"],
    },
    "js/src/wrappers/vitest": {
      "entry": ["*.test.ts"],
      "project": ["*.ts"],
    },
    "integrations/deepseek-harness": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "integrations/otel-js": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts",
        "tests/**/*.ts",
        "examples/**/*.{ts,js,mjs,cjs}",
        "smoke/**/*.{ts,js,mjs,cjs}",
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "examples/**/*.{ts,js,mjs,cjs}",
        "smoke/**/*.{ts,js,mjs,cjs}",
      ],
    },
    "integrations/temporal-js": {
      "entry": [
        "src/index.ts",
        "src/workflow-interceptors.ts",
        "examples/**/*.{ts,js,mjs,cjs}",
      ],
      "project": ["src/**/*.ts", "examples/**/*.{ts,js,mjs,cjs}"],
    },
    "integrations/templates-nunjucks": {
      "entry": ["src/index.ts", "smoke/**/*.{ts,tsx,js,jsx,mjs,cjs}"],
      "project": ["src/**/*.ts", "smoke/**/*.{ts,tsx,js,jsx,mjs,cjs,d.ts}"],
    },
  },
}
