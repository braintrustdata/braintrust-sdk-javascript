{
  "name": "braintrust-sdk-js",
  "version": "0.0.1",
  "repository": "https://github.com/braintrustdata/braintrust-sdk-javascript",
  "license": "MIT",
  "private": true,
  "scripts": {
    "preinstall": "node -e \"const userAgent = process.env.npm_config_user_agent || ''; if (process.env.INIT_CWD === process.cwd() && !userAgent.includes('pnpm/')) { console.error('Use pnpm in this repo.'); process.exit(1); }\"",
    "build": "vp run -r build",
    "check:typings": "vp run -r check:typings",
    "dev": "vp run -r dev",
    "watch": "vp run -r watch",
    "start": "vp run -r start",
    "clean": "vp run -r clean",
    "knip": "knip --config knip.jsonc --no-config-hints",
    "test": "vp run --filter='*' --filter='@braintrust/*' --filter='!braintrust-sdk-js' --filter='!@braintrust/otel' test",
    "test:e2e": "vp run -r test:e2e",
    "test:e2e:update": "vp run -r test:e2e:update",
    "test:e2e:record": "node e2e/scripts/run-record-tests.mjs --braintrust-build-deps",
    "test:e2e:bump": "node e2e/scripts/run-e2e-bump-docker.mjs",
    "dotagents:install": "dotagents install",
    "dotagents:sync": "dotagents sync",
    "changeset": "changeset",
    "playground": "vp run --filter=braintrust playground",
    "formatting": "vp fmt --check .",
    "lint": "vp lint .",
    "fix:formatting": "vp fmt --write .",
    "fix:lint": "vp lint --fix .",
    "yalc:publish": "vp run -r yalc:publish",
    "pretest:e2e": "pnpm run build",
    "pretest:e2e:update": "pnpm run build",
    "pretest": "pnpm run build",
    "precheck:typings": "pnpm run build",
    "check": "vp check",
    "test:e2e:cassettes": "pnpm run test:e2e -- --check-cassettes"
  },
  "engines": {
    "pnpm": ">=10.27.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@changesets/get-github-info": "^0.8.0",
    "@sentry/dotagents": "1.17.0",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "knip": "^5.85.0",
    "lint-staged": "^16.2.7",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yalc": "1.0.0-pre.53"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs,css,md,mdx,html,yaml,yml,json}": "vp fmt --write"
  },
  "packageManager": "pnpm@10.33.0"
}
