{
  "name": "braintrust",
  "version": "3.42.0",
  "description": "SDK for integrating Braintrust",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braintrustdata/braintrust-sdk-javascript.git",
    "directory": "js"
  },
  "homepage": "https://www.braintrust.dev/docs",
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "sideEffects": [
    "./dist/*/auto.js",
    "./dist/node/apply-auto-instrumentation.js",
    "./dist/hooks/hook.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "workerd": "./dist/workerd/index.js",
      "edge-light": "./dist/edge-light/index.js",
      "browser": "./dist/browser/index.js",
      "node": "./dist/node/index.js",
      "default": "./dist/browser/index.js"
    },
    "./package.json": "./package.json",
    "./auto": {
      "types": "./dist/node/auto.d.ts",
      "workerd": "./dist/workerd/auto.js",
      "edge-light": "./dist/edge-light/auto.js",
      "browser": "./dist/browser/auto.js",
      "node": "./dist/node/auto.js",
      "default": "./dist/browser/auto.js"
    },
    "./custom-views": {
      "types": "./dist/node/custom-views.d.ts",
      "workerd": "./dist/workerd/custom-views.js",
      "edge-light": "./dist/edge-light/custom-views.js",
      "browser": "./dist/browser/custom-views.js",
      "node": "./dist/node/custom-views.js",
      "default": "./dist/browser/custom-views.js"
    },
    "./preprocessors": {
      "types": "./dist/node/preprocessors.d.ts",
      "workerd": "./dist/workerd/preprocessors.js",
      "edge-light": "./dist/edge-light/preprocessors.js",
      "browser": "./dist/browser/preprocessors.js",
      "node": "./dist/node/preprocessors.js",
      "default": "./dist/browser/preprocessors.js"
    },
    "./instrumentation": {
      "types": "./dist/node/instrumentation.d.ts",
      "workerd": "./dist/workerd/instrumentation.js",
      "edge-light": "./dist/edge-light/instrumentation.js",
      "browser": "./dist/browser/instrumentation.js",
      "node": "./dist/node/instrumentation.js",
      "default": "./dist/browser/instrumentation.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./workerd": {
      "types": "./dist/workerd/index.d.ts",
      "default": "./dist/workerd/index.js"
    },
    "./edge-light": {
      "types": "./dist/edge-light/index.d.ts",
      "default": "./dist/edge-light/index.js"
    },
    "./apply-auto-instrumentation": {
      "types": "./dist/node/apply-auto-instrumentation.d.ts",
      "workerd": "./dist/workerd/apply-auto-instrumentation.js",
      "edge-light": "./dist/edge-light/apply-auto-instrumentation.js",
      "browser": "./dist/browser/apply-auto-instrumentation.js",
      "node": "./dist/node/apply-auto-instrumentation.js",
      "default": "./dist/browser/apply-auto-instrumentation.js"
    },
    "./vitest-evals-reporter": {
      "types": "./dist/node/vitest-evals-reporter.d.ts",
      "default": "./dist/node/vitest-evals-reporter.js"
    },
    "./hook.mjs": "./dist/hooks/hook.mjs",
    "./vite": {
      "types": "./dist/tooling/bundler/vite.d.ts",
      "default": "./dist/tooling/bundler/vite.js"
    },
    "./webpack": {
      "types": "./dist/tooling/bundler/webpack.d.ts",
      "default": "./dist/tooling/bundler/webpack.js"
    },
    "./next": {
      "types": "./dist/tooling/bundler/next.d.ts",
      "default": "./dist/tooling/bundler/next.js"
    },
    "./esbuild": {
      "types": "./dist/tooling/bundler/esbuild.d.ts",
      "default": "./dist/tooling/bundler/esbuild.js"
    },
    "./rollup": {
      "types": "./dist/tooling/bundler/rollup.d.ts",
      "default": "./dist/tooling/bundler/rollup.js"
    }
  },
  "files": [
    "dist/**/*",
    "NOTICE",
    "licenses/**/*"
  ],
  "scripts": {
    "build": "vp run compile",
    "check:typings": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "watch": "vp pack --watch",
    "clean": "rm -r dist/*",
    "docs": "typedoc --options typedoc.json src/node/index.ts",
    "test": "vp test run --exclude \"src/wrappers/**/*.test.ts\" --exclude \"src/otel/**/*.test.ts\" --exclude \"smoke/**/*.test.ts\" --exclude \"tests/api-compatibility/**\"",
    "test:core": "pnpm prune && pnpm test",
    "test:checks": "pnpm run test:core && pnpm run test:vitest",
    "test:all": "pnpm run test:checks",
    "test:api-compat": "vp test run tests/api-compatibility/api-compatibility.test.ts",
    "test:otel": "vp test run --dir src/otel",
    "test:otel-no-deps": "vp test run src/otel/otel-no-deps.test.ts --reporter=verbose",
    "test:ai-sdk-v1": "vp test run src/wrappers/ai-sdk-v1.test.ts",
    "test:ai-sdk-v2": "vp test run src/wrappers/ai-sdk-v2.test.ts src/wrappers/ai-sdk-v1.test.ts",
    "test:mastra": "vp test run src/wrappers/mastra.test.ts",
    "test:vitest": "pnpm --filter @braintrust/vitest-wrapper-tests test",
    "bench": "tsx src/queue.bench.ts",
    "lint": "vp lint .",
    "fix:lint": "vp lint --fix .",
    "playground": "tsx playground.ts",
    "playground:auto": "mkdir -p .context && pnpm exec esbuild playground.ts --platform=node --format=esm --outfile=.context/playground.auto.mjs && node --import ./dist/hooks/hook.mjs ./.context/playground.auto.mjs",
    "yalc:publish": "yalc publish"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@types/async": "^3.2.24",
    "@types/esquery": "^1.5.4",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.10.5",
    "@types/react": "^18.3.1",
    "ai": "^6.0.0",
    "async": "^3.2.5",
    "cross-env": "^7.0.3",
    "esbuild": "0.28.1",
    "eslint-plugin-n": "^18.2.1",
    "openai": "6.25.0",
    "rollup": "^4.60.3",
    "tar": "^7.5.22",
    "tinybench": "^4.0.1",
    "ts-declaration-location": "^1.0.7",
    "tsx": "^4.21.0",
    "typedoc": "^0.25.13",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "5.4.4",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "webpack": "^5.106.2",
    "zod": "^3.25.34",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@vercel/functions": "^1.0.2",
    "acorn": "^8.16.0",
    "acorn-import-attributes": "^1.9.5",
    "ajv": "^8.20.0",
    "astring": "^1.9.0",
    "cjs-module-lexer": "^2.2.0",
    "dotenv": "^16.4.5",
    "esquery": "^1.7.0",
    "eventsource-parser": "^1.1.2",
    "meriyah": "^6.1.4",
    "module-details-from-path": "^1.0.4",
    "mustache": "^4.2.0",
    "semifies": "^1.0.0",
    "source-map": "^0.7.4",
    "unplugin": "^2.3.5",
    "uuid": "^11.1.1",
    "zod-to-json-schema": "^3.25.0"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "zod": "^3.25.34 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "type": "module"
}
