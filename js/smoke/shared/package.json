    "watch": "vp pack --watch"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "typescript": "^5.4.4",
    "vite-plus": "1.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "type": "module"
}
