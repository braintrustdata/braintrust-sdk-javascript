{
  "compilerOptions": {
    "declaration": true,
    "lib": ["es2022"],
    "module": "ESNext",
    "target": "es2022",
    "moduleResolution": "Bundler",
    "paths": {
      "@apm-js-collab/code-transformer": [
        "./src/auto-instrumentations/orchestrion-js/index.ts"
      ],
      "#braintrust-platform": ["./src/isomorph.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["."],
  "exclude": [
    "**/*.test.ts",
    "**/dist/**",
    "**/examples/**",
    "node_modules/**",
    "**/smoke/**",
    "scripts/**",
    "vendor/**",
    "src/auto-instrumentations/**/*.mts",
    "src/auto-instrumentations/bundler/**",
    "src/auto-instrumentations/configs/**",
    "src/auto-instrumentations/loader/**",
    "tests/auto-instrumentations/**",
    "./playground.ts",
    "vite.config.ts"
  ]
}
