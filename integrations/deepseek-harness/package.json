{
  "name": "@braintrust/deepseek-harness",
  "version": "1.0.0",
  "description": "Braintrust tracing plugin for DeepSeek Harness",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist/**/*",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "vp run compile",
    "check:typings": "tsc --noEmit",
    "watch": "vp pack --watch",
    "clean": "rm -r dist/*",
    "test": "vp test run",
    "yalc:publish": "yalc publish"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "braintrust": "workspace:^",
    "zod": "^3.25.34 || ^4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^22.15.21",
    "typescript": "^5.5.4",
    "vite-plus": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braintrustdata/braintrust-sdk-javascript.git",
    "directory": "integrations/deepseek-harness"
  },
  "homepage": "https://www.braintrust.dev/docs",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "sideEffects": false
}
