{
  "name": "@braintrust/templates-nunjucks-js",
  "version": "1.0.0",
  "description": "Nunjucks templating support for the Braintrust JS SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "vp run compile",
    "check:typings": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "watch": "vp pack --watch",
    "clean": "rm -r dist/*",
    "test": "vp test run --exclude 'smoke/scenarios/**'",
    "yalc:publish": "yalc publish"
  },
  "author": "Braintrust Data Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "nunjucks": "^3.2.4"
  },
  "peerDependencies": {
    "braintrust": ">=3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/nunjucks": "^3.2.6",
    "braintrust": "workspace:*",
    "typescript": "5.5.4",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braintrustdata/braintrust-sdk-javascript.git",
    "directory": "integrations/templates-nunjucks"
  },
  "homepage": "https://www.braintrust.dev/docs",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "sideEffects": false
}
