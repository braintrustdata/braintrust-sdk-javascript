le_fraction\":0,\"classification_model\":\"\",\"enabled\":false,\"cost_limit\":0,\"request_route_fraction\":0,\"sample_rate_denominator\":0,\"routing_strategy\":\"\",\"vega_mxfp8_arm\":\"\",\"routing_models\":\"\",\"taxonomy_type\":\"\",\"model\":\"\",\"randomize_candidates\":false,\"taxonomy\":\"\",\"prompt_variant\":\"\",\"cinderleaf_quantization\":\"\",\"models_in_the_mix\":0,\"classifier_group\":\"\",\"grok_satisfaction_threshold\":0,\"inference_sampling_params\":{},\"compass_model_type\":\"\",\"lower_boundary_for_sending_to_composer\":0,\"margin_needed_for_sending_to_composer\":0,\"compass_v4_lambda\":0,\"combined_algorithm_fallback_taxonomy_type\":\"\",\"context\":\"\"},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"model\"],\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1579959099\":{\"name\":\"1579959099\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"clientId\":\"3660753192626.8903469228982\"},\"is_device_based\":false,\"passed\":false},\"1580733381\":{\"name\":\"1580733381\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1582580182\":{\"name\":\"1582580182\",\"rule_id\":\"inlineTargetingRules\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1585243471\":{\"name\":\"1585243471\",\"rule_id\":\"abandoned\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"compass_fast_path_model\":\"\",\"compass_v4_pinned_model\":\"\",\"ui_browser_verification_prompt_enabled\":true,\"table_version\":0,\"tier\":\"\",\"user_cooldown_seconds\":86400,\"sample_fraction\":0,\"classification_model\":\"\",\"enabled\":false,\"cost_limit\":0,\"request_route_fraction\":0,\"sample_rate_denominator\":0,\"routing_strategy\":\"\",\"vega_mxfp8_arm\":\"\",\"routing_models\":\"\",\"taxonomy_type\":\"\",\"model\":\"\",\"randomize_candidates\":false,\"taxonomy\":\"\",\"prompt_variant\":\"\",\"cinderleaf_quantization\":\"\",\"models_in_the_mix\":0,\"classifier_group\":\"\",\"grok_satisfaction_threshold\":0,\"inference_sampling_params\":{},\"compass_model_type\":\"\",\"lower_boundary_for_sending_to_composer\":0,\"margin_needed_for_sending_to_composer\":0,\"compass_v4_lambda\":0,\"combined_algorithm_fallback_taxonomy_type\":\"\",\"context\":\"\"},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"model\"],\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1586831196\":{\"name\":\"1586831196\",\"rule_id\":\"abandoned\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"compass_fast_path_model\":\"\",\"compass_v4_pinned_model\":\"\",\"ui_browser_verification_prompt_enabled\":true,\"table_version\":0,\"tier\":\"\",\"user_cooldown_seconds\":86400,\"sample_fraction\":0,\"classification_model\":\"\",\"enabled\":false,\"cost_limit\":0,\"request_route_fraction\":0,\"sample_rate_denominator\":0,\"routing_strategy\":\"\",\"vega_mxfp8_arm\":\"\",\"routing_models\":\"\",\"taxonomy_type\":\"\",\"model\":\"\",\"randomize_candidates\":false,\"taxonomy\":\"\",\"prompt_variant\":\"\",\"cinderleaf_quantization\":\"\",\"models_in_the_mix\":0,\"classifier_group\":\"\",\"grok_satisfaction_threshold\":0,\"inference_sampling_params\":{},\"compass_model_type\":\"\",\"lower_boundary_for_sending_to_composer\":0,\"margin_needed_for_sending_to_composer\":0,\"compass_v4_lambda\":0,\"combined_algorithm_fallback_taxonomy_type\":\"\",\"context\":\"\"},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"model\",\"routing_strategy\"],\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1594705455\":{\"name\":\"1594705455\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"stableID\",\"value\":{\"group\":\"control\"},\"is_device_based\":true,\"group_name\":\"Control\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1595420948\":{\"name\":\"1595420948\",\"rule_id\":\"6NtSYmjK1ELPy2ZhKHrBNw-6NtSYkEHzmCleDrm9zvYuu\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"sendMessageGuidance\":\"## Communicating with the user\\n\\nThe `{{SEND_MESSAGE_TOOL_NAME}}` tool is how the user hears from you. Regular assistant text is treated as internal thinking and is not shown to the user.\\n\\nOn a person-opened turn, complete the turn's work first, then send your message. Make `notes.md` edits after the last send, silently, then end the turn.\\n\\nA successful {{SEND_MESSAGE_TOOL_NAME}} result means the payload was accepted, not that the user has seen it.\\n\\nUse `{{SEND_MESSAGE_TOOL_NAME}}` for:\\n- meaningful progress updates;\\n- questions or blockers requiring user input when the Ask Question tool is not appropriate;\\n- the final result of your work.\\n\\nAfter a progress message, continue working normally. After the final `{{SEND_MESSAGE_TOOL_NAME}}` of the turn succeeds, send no further messages and emit no wrap-up narration; finish silent `notes.md` bookkeeping, then end the turn.\",\"coordinatorToolsGuidance\":\"## Coordinating workers\\n\\nCreate workers with `CreateAgent`. Each worker runs as an independent top-level cloud agent on its own cloud VM. Turn-end notifications usually arrive as system notifications, but they are best-effort — a successful CreateAgent or SendToAgent result is not a completion signal. Continue other work after dispatch. If you need a result and no notification has arrived, use GetAgentStatus or ReadAgentTranscript rather than sitting idle. Do not tell the user a worker is still working without checking. There is no Task / Subagent tool on this coordinator.\\n\\nYou are already the coordinator. `CreateAgent` the actual work slices immediately. Give each worker a short kickoff taken from the user request. Do not Grep, Read, or call MCP first to research or enlarge the kickoff, and do not wait for the Agent Store, `notes.md`, or a workers catalog before launching. Do not `CreateAgent` another coordinator to own fan-out for a single user request — that extra hop duplicates the work and delays the first real read. Spawn a coordinator child only for a second large project or a high-volume audit whose many completions would flood this chat.\\n\\n- `CreateAgent` — create a worker from a kickoff prompt (optionally a name and model). Returns the worker's agent id immediately; the worker boots and runs asynchronously. The `machine` placement mirrors the Task tool's: a dedicated cloud VM by default (`new_cloud_vm`, with optional `base_branch` and `environment_build_id`), one of the owner's self-hosted machines (`self_hosted_worker` + `worker_id`), or a self-hosted pool (`self_hosted_pool` + optional `pool`/`labels`).\\n- `GetAgentStatus` — on-demand status of your workers (lifecycle, turn in flight, last turn outcome, PR). Use it when you need a snapshot, when a notification has not arrived, or before telling the user a worker is still working.\\n- `SendToAgent` — send a worker a message: `queue` (default) delivers it as the worker's next turn, `steer` injects into a running turn (falls back to queue when idle). The result reports how the message was actually delivered.\\n- `ReadAgentTranscript` — read a bounded tail of a worker's conversation when you need the actual content, not just its status.\\n- `StopAgent` — abort a worker's current turn. The worker stays available; use `SendToAgent` to give it new instructions.\"},\"is_device_based\":false,\"passed\":false},\"1601164882\":{\"name\":\"1601164882\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"tools\":{\"RIPGREP_SEARCH\":{\"ttl\":10000,\"maxConcurrent\":5},\"RIPGREP_RAW_SEARCH\":{\"ttl\":10000,\"maxConcurrent\":5}},\"defaultTtl\":100,\"defaultMaxConcurrent\":999999},\"is_device_based\":false,\"passed\":false},\"1608702035\":{\"name\":\"1608702035\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":false},\"is_device_based\":false,\"group_name\":\"Control\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1620480869\":{\"name\":\"1620480869\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1621623698\":{\"name\":\"1621623698\",\"rule_id\":\"inlineTargetingRules\",\"secondary_exposures\":[],\"id_type\":\"stableID\",\"value\":{},\"is_device_based\":true,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1625817286\":{\"name\":\"1625817286\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"1634131150\":{\"name\":\"1634131150\",\"rule_id\":\"targetingGate\",\"secondary_exposures\":[{\"gate\":\"707796608\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1634828406\":{\"name\":\"1634828406\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"dummy\":\"\"},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1637108778\":{\"name\":\"1637108778\",\"rule_id\":\"abandoned\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"compass_fast_path_model\":\"\",\"compass_v4_pinned_model\":\"\",\"ui_browser_verification_prompt_enabled\":true,\"table_version\":0,\"tier\":\"\",\"user_cooldown_seconds\":86400,\"sample_fraction\":0,\"classification_model\":\"\",\"enabled\":false,\"cost_limit\":0,\"request_route_fraction\":0,\"sample_rate_denominator\":0,\"routing_strategy\":\"\",\"vega_mxfp8_arm\"