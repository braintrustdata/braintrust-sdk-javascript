nts, view console logs, and analyze network traffic\",\"action\":{\"label\":\"@browser\",\"kind\":\"prompt\",\"text\":\"Enable Cursor Browser tools and pull up \"}},{\"text\":\"Use /create-subagent to set up specialized agents that Cursor can use to parallelize work\",\"targetSurfaces\":[\"editor\",\"glass\"],\"id\":\"subagents-create\",\"action\":{\"kind\":\"prompt\",\"label\":\"/create-subagent\",\"text\":\"/create-subagent for this workflow: \"}},{\"action\":{\"label\":\"use subagents\",\"kind\":\"prompt\",\"text\":\"Use subagents to break this down, do work in parallel, and preserve context: \"},\"id\":\"subagents-parallelize\",\"text\":\"Tell Cursor to use subagents to break down tasks, do work in parallel, and preserve context\",\"targetSurfaces\":[\"editor\",\"glass\"]},{\"targetSurfaces\":[\"editor\",\"glass\"],\"id\":\"skills-create\",\"text\":\"Use /create-skill to customize Cursor for your workflows\",\"action\":{\"text\":\"/create-skill for this workflow: \",\"label\":\"/create-skill\",\"kind\":\"prompt\"}},{\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"label\":\"/create-skill\",\"text\":\"/create-skill for this workflow: \",\"kind\":\"prompt\"},\"id\":\"skills-customize\",\"text\":\"Agent skills help you customize Cursor for your workflows - use /create-skill to get started\"},{\"action\":{\"mode\":\"plan\",\"kind\":\"mode\",\"label\":\"Plan Mode\"},\"id\":\"plan-mode-shift-tab\",\"targetSurfaces\":[\"editor\",\"glass\"],\"text\":\"Plan Mode improves agent outcomes and accuracy - hit shift+tab to get started\"},{\"text\":\"Use /plan to improve agent execution with Plan Mode\",\"id\":\"plan-mode-plan\",\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"kind\":\"prompt\",\"mode\":\"plan\",\"text\":\"Create a /plan for this task: \",\"label\":\"/plan\"}},{\"action\":{\"label\":\"Debug Mode\",\"kind\":\"mode\",\"mode\":\"debug\"},\"id\":\"debug-mode-shift-tab\",\"text\":\"Debug Mode reproduces and solves your most difficult bugs - hit shift+tab twice to get started\",\"targetSurfaces\":[\"editor\",\"glass\"]},{\"id\":\"debug-mode-command\",\"targetSurfaces\":[\"editor\",\"glass\"],\"text\":\"Use /debug to solve bugs that are hard to reproduce or understand\",\"action\":{\"text\":\"/debug this issue: \",\"mode\":\"debug\",\"kind\":\"prompt\",\"label\":\"/debug\"}},{\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"kind\":\"mode\",\"mode\":\"ask\",\"label\":\"Ask Mode\"},\"id\":\"ask-mode-shift-tab\",\"text\":\"Ask Mode uses read-only agents to research your codebase - hit shift+tab to get started\"},{\"text\":\"Use /ask to research your codebase before starting code changes\",\"targetSurfaces\":[\"editor\",\"glass\"],\"id\":\"ask-mode-command\",\"action\":{\"label\":\"/ask\",\"mode\":\"ask\",\"kind\":\"prompt\",\"text\":\"Explain this code to me using /ask \"}},{\"action\":{\"url\":\"cursor://anysphere.cursor-deeplink/settings/mcp\",\"label\":\"Cursor Settings\",\"kind\":\"deeplink\"},\"id\":\"mcp\",\"targetSurfaces\":[\"editor\",\"glass\"],\"text\":\"Configure MCPs in your Cursor Settings to give agents access to tools and data\"},{\"text\":\"Use cloud agents for better parallelization and durable execution at cursor.com/agents\",\"targetSurfaces\":[\"editor\"],\"id\":\"cloud-agents\",\"action\":{\"kind\":\"link\",\"label\":\"cursor.com/agents\",\"url\":\"https://cursor.com/agents\"}},{\"text\":\"Use /cloud or /local to move agent sessions between runtimes\",\"id\":\"cloud-local-runtime\",\"action\":{\"text\":\"/cloud \",\"kind\":\"prompt\",\"label\":\"/cloud\"},\"targetSurfaces\":[\"editor\",\"glass\"]},{\"targetSurfaces\":[\"editor\",\"glass\"],\"id\":\"cloud\",\"text\":\"Use /cloud to run agents remotely for better parallelization and durable execution\",\"action\":{\"text\":\"/cloud \",\"label\":\"/cloud\",\"kind\":\"prompt\"}},{\"action\":{\"label\":\"/in-cloud\",\"text\":\"/in-cloud \",\"kind\":\"prompt\"},\"id\":\"in-cloud\",\"targetSurfaces\":[\"editor\",\"glass\"],\"text\":\"Use /in-cloud to start a subagent in its own cloud VM, keeping your local workspace free\"},{\"id\":\"automations-editor\",\"targetSurfaces\":[\"editor\"],\"text\":\"Set up automations to automate tasks and save time at cursor.com/automations\",\"action\":{\"url\":\"https://cursor.com/automations\",\"label\":\"cursor.com/automations\",\"kind\":\"link\"}},{\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"kind\":\"deeplink\",\"url\":\"cursor://anysphere.cursor-deeplink/automations\",\"label\":\"automations\"},\"text\":\"Use automations to save time on repetitive tasks with always-on agents\",\"id\":\"automations-glass\"},{\"id\":\"loop\",\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"label\":\"/loop\",\"kind\":\"prompt\",\"text\":\"/loop do this task every hour - \"},\"text\":\"Use /loop to run a prompt on a schedule\"},{\"action\":{\"text\":\"/automate this workflow: \",\"label\":\"/automate\",\"kind\":\"prompt\"},\"id\":\"automate\",\"text\":\"Use /automate to create Cursor Automations without leaving your agent chat\",\"targetSurfaces\":[\"editor\",\"glass\"]},{\"targetSurfaces\":[\"editor\"],\"id\":\"best-of-n\",\"text\":\"Use /best-of-N to compare how different models perform on the same task\",\"action\":{\"kind\":\"prompt\",\"text\":\"Use /best-of-N to compare models on this task: \",\"label\":\"/best-of-N\"}},{\"text\":\"Use /model to pick the best model for your task and select Grok for a great balance of cost vs. capability\",\"id\":\"model-picker\",\"action\":{\"commandId\":\"glass.openModelPicker\",\"kind\":\"command\",\"label\":\"/model\"},\"targetSurfaces\":[\"glass\"]},{\"id\":\"hooks-get-started\",\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"text\":\"/create-hook for this workflow: \",\"kind\":\"prompt\",\"label\":\"/create-hook\"},\"text\":\"Hooks let you control and extend the agent loop - use /create-hook to get started\"},{\"id\":\"hooks-scripts\",\"targetSurfaces\":[\"editor\",\"glass\"],\"text\":\"Use /create-hook to control and extend the agent loop with custom scripts\",\"action\":{\"kind\":\"prompt\",\"text\":\"/create-hook with a custom script for this workflow: \",\"label\":\"/create-hook\"}},{\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"text\":\"Create a /canvas for this data: \",\"kind\":\"prompt\",\"label\":\"/canvas\"},\"text\":\"Cursor can respond with interactive visualizations alongside text - use /canvas to get started\",\"id\":\"canvas-get-started\"},{\"id\":\"canvas-dashboards\",\"targetSurfaces\":[\"editor\",\"glass\"],\"text\":\"Use /canvas to get interactive visualizations like dashboards from Cursor\",\"action\":{\"text\":\"Create a /canvas dashboard for this data: \",\"label\":\"/canvas\",\"kind\":\"prompt\"}},{\"id\":\"shell\",\"text\":\"Use /shell to run commands in the terminal\",\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"label\":\"/shell\",\"kind\":\"prompt\",\"text\":\"/shell run this command and explain the output: \"}},{\"id\":\"worktrees\",\"text\":\"Use /worktree to run the agent task in a separate git worktree\",\"targetSurfaces\":[\"editor\"],\"action\":{\"kind\":\"prompt\",\"text\":\"Use a /worktree to run this task \",\"label\":\"/worktree\"}},{\"text\":\"Use /simplify to have Cursor review all changed files for code quality and efficiency\",\"targetSurfaces\":[\"editor\",\"glass\"],\"id\":\"simplify\",\"action\":{\"text\":\"/simplify review the changed files for code quality and efficiency\",\"label\":\"/simplify\",\"kind\":\"prompt\"}},{\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"kind\":\"prompt\",\"label\":\"/review\",\"text\":\"/review this change for bugs, regressions, security issues, and missing tests\"},\"text\":\"Use /review to have Cursor find bugs, regressions, security issues, and missing tests\",\"id\":\"code-review-review\"},{\"action\":{\"label\":\"/babysit\",\"kind\":\"prompt\",\"text\":\"/babysit this PR until it is green and merge-ready\"},\"targetSurfaces\":[\"editor\",\"glass\"],\"id\":\"code-review-babysit\",\"text\":\"Use /babysit to triage PR comments, fix CI failures, and clear conflicts\"},{\"text\":\"After long sessions, use /split-to-prs to turn your work into small, reviewable PRs\",\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"text\":\"Take this session and /split-to-prs for small, reviewable PRs \",\"label\":\"/split-to-prs\",\"kind\":\"prompt\"},\"id\":\"split-prs\"},{\"action\":{\"kind\":\"command\",\"commandId\":\"glass.openMarketplace\",\"label\":\"/add-plugin\"},\"text\":\"Use /add-plugin to install a plugin from the Cursor Marketplace\",\"id\":\"plugins-install\",\"targetSurfaces\":[\"editor\",\"glass\"]},{\"text\":\"Plugins help you customize Cursor for your workflows - use /add-plugin to get started\",\"targetSurfaces\":[\"editor\",\"glass\"],\"id\":\"plugins-customize\",\"action\":{\"kind\":\"prompt\",\"text\":\"/add-plugin for this workflow: \",\"label\":\"/add-plugin\"}},{\"action\":{\"url\":\"cursor://anysphere.cursor-deeplink/glass\",\"label\":\"Agents Window\",\"kind\":\"deeplink\"},\"targetSurfaces\":[\"editor\"],\"text\":\"The Agents Window lets you parallelize agents across repos - hit ctrl+shift+P to start\",\"id\":\"agents-window\"},{\"id\":\"projects-create\",\"targetSurfaces\":[\"glass\"],\"text\":\"Create a Project to give agents a shared assignment and track their progress in one place\",\"action\":{\"kind\":\"command\",\"label\":\"Create a Project\",\"commandId\":\"glass.createProject\"}},{\"action\":{\"commandId\":\"glass.splitTileHorizontal\",\"label\":\"split your view\",\"kind\":\"command\"},\"id\":\"tiling-drag-drop\",\"targetSurfaces\":[\"glass\"],\"text\":\"Drag and drop agent chats to split your view into tiled panes\"},{\"targetSurfaces\":[\"editor\",\"glass\"],\"id\":\"ask-summarize-conversations\",\"action\":{\"text\":\"Find a prior conversation or summarize across conversations about: \",\"kind\":\"prompt\",\"label\":\"Ask Cursor\"},\"text\":\"Ask Cursor to find a prior conversation, or summarize across conversations\"},{\"text\":\"Voice mode lets you dictate better prompts for your agents\",\"targetSurfaces\":[\"glass\"],\"action\":{\"kind\":\"command\",\"commandId\":\"glass.useVoice\",\"label\":\"Voice mode\"},\"id\":\"voice-mode\"},{\"id\":\"review\",\"text\":\"Use /review for an agentic code review of your changes\",\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"kind\":\"prompt\",\"label\":\"/review\",\"text\":\"/review \"}},{\"id\":\"goal-command\",\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"label\":\"/goal\",\"kind\":\"prompt\",\"text\":\"/goal \"},\"text\":\"Use /goal to set an objective that Cursor keeps pursuing until it is complete\"},{\"id\":\"goal-durable\",\"text\":\"Goals keep agents working across turns until the job is done - use /goal to get started\",\"targetSurfaces\":[\"editor\",\"glass\"],\"action\":{\"label\":\"/goal\",\"kind\":\"prompt\",\"text\":\"/goal finish this task end to end: \"}},{\"action\":{\"url\":\"cursor://anysphere.cursor-deeplink/settings/chat\",\"kind\":\"deeplink\",\"label\":\"Agents settings\"},\"text\":\"Steer a running agent without stopping it - set New Messages to Send Immediately in your Agents settings\",\"id\":\"steer-send-immediately\",\"targetSurfaces\":[\"editor\",\"glass\"]},{\"targetSurfaces\":[\"editor\",\"glass\"],\"text\":\"Messages sent while Cursor is working can steer it mid-run without interrupting - turn it on under New Messages in Agents settings\",\"action\":{\"label\":\"New Messages\",\"kind\":\"deeplink\",\"url\":\"cursor://anysphere.cursor-deeplink/settings/chat\"},\"id\":\"steer-mid-run\"}],\"config\":{\"minClientVersion\":\"3.5.18\",\"intervalMs\":20000,\"devIntervalMs\":20000}},\"is_device_based\":false,\"passed\":false},\"1977902736\":{\"name\":\"1977902736\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1980253744\":{\"name\":\"1980253744\",\"rule_id\