troubleshooting\",\"value\":\"Debugging\"},{\"rule\":\"Resolving defects, performance issues, regressions\",\"value\":\"Bug Fixing\"},{\"value\":\"DevOps\",\"rule\":\"CI/CD, deployment, Docker, Kubernetes\"},{\"rule\":\"Cloud infrastructure, servers, networking, scaling\",\"value\":\"Infrastructure\"},{\"rule\":\"Build setup, linting, environment config, tooling\",\"value\":\"Configuration\"},{\"rule\":\"Shell scripts, automation scripts, one-off scripts, batch operations\",\"value\":\"Scripting\"}]},{\"description\":\"pick EXACTLY ONE\",\"values\":[{\"rule\":\"Easy task, 1-2 files, small amount of code\",\"value\":\"low\"},{\"value\":\"medium\",\"rule\":\"Medium difficulty, 3-10 files, editing related files\"},{\"rule\":\"Hard task, cross-cutting concerns, many searches/edits, architectural changes\",\"value\":\"high\"}],\"name\":\"complexity\"},{\"description\":\"pick EXACTLY ONE\",\"name\":\"intent\",\"values\":[{\"value\":\"Plan\",\"rule\":\"Planning a feature or approach before implementation\"},{\"value\":\"Ask\",\"rule\":\"Understanding the codebase, asking questions\"},{\"value\":\"Task Automation\",\"rule\":\"Delegating common tasks (git commit, lint, build, create PR)\"},{\"value\":\"Write Code\",\"rule\":\"Writing code and building features\"}]},{\"values\":[{\"rule\":\"How to implement something specific\",\"value\":\"Implementation Guidance\"},{\"value\":\"Architecture\",\"rule\":\"System design, structure, patterns\"},{\"rule\":\"Conventions, standards, recommended approaches\",\"value\":\"Best Practices\"},{\"rule\":\"Understanding code, concepts, or behavior\",\"value\":\"Explanation\"},{\"rule\":\"Finding specific code, patterns, or usages\",\"value\":\"Advanced Search\"},{\"value\":\"Code Review\",\"rule\":\"Reviewing, improving, or critiquing code\"},{\"rule\":\"Breaking down features into tasks\",\"value\":\"Feature Breakdown\"},{\"rule\":\"Planning upgrades, migrations, or transitions\",\"value\":\"Migration Planning\"},{\"rule\":\"Planning code restructuring\",\"value\":\"Refactor Planning\"},{\"value\":\"Step-by-Step Implementation\",\"rule\":\"Detailed implementation steps\"},{\"value\":\"Rollout Strategy\",\"rule\":\"Deployment, release, or rollout planning\"}],\"name\":\"subcategories\",\"description\":\"pick 0-2 that best describe the task focus\"}],\"systemIntro\":\"You are a classifier that tags coding assistant conversations. You MUST output ONLY valid JSON with ONLY the exact values listed below.\",\"version\":\"1.0.0\",\"examples\":[{\"output\":{\"categories\":[\"Styling\"],\"complexity\":\"low\",\"subcategories\":[],\"intent\":\"Write Code\"},\"input\":\"Change the button color to blue\"},{\"input\":\"How does React's useEffect hook work?\",\"output\":{\"complexity\":\"low\",\"intent\":\"Ask\",\"subcategories\":[\"Explanation\"],\"categories\":[]}},{\"output\":{\"categories\":[],\"intent\":\"Task Automation\",\"complexity\":\"low\",\"subcategories\":[]},\"input\":\"commit and push\"},{\"output\":{\"complexity\":\"medium\",\"intent\":\"Plan\",\"categories\":[\"Refactoring\"],\"subcategories\":[\"Refactor Planning\"]},\"input\":\"Refactor the user service to use dependency injection\"},{\"output\":{\"categories\":[\"New Features\"],\"intent\":\"Plan\",\"complexity\":\"high\",\"subcategories\":[\"Feature Breakdown\",\"Architecture\"]},\"input\":\"Plan the implementation of a real-time chat feature with WebSockets\"},{\"input\":\"Set up GitHub Actions for running tests on PR\",\"output\":{\"categories\":[\"DevOps\",\"Testing\"],\"complexity\":\"medium\",\"subcategories\":[\"Step-by-Step Implementation\"],\"intent\":\"Write Code\"}},{\"output\":{\"complexity\":\"low\",\"categories\":[],\"subcategories\":[\"Code Review\"],\"intent\":\"Ask\"},\"input\":\"Review this function and suggest improvements\"}]},\"is_device_based\":false,\"passed\":false},\"2181361397\":{\"name\":\"2181361397\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"stableID\",\"value\":{\"group\":\"variant_b\"