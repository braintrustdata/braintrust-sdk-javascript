d\":\"prestart\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2474677018\":{\"name\":\"2474677018\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"dummy\":\"\"},\"is_device_based\":false,\"group_name\":\"Control\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2481185605\":{\"name\":\"2481185605\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2487602440\":{\"name\":\"2487602440\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"recommendedPluginNamesByJobRole\":{\"student\":[\"vercel\",\"figma\"],\"data\":[\"amplitude\",\"databricks\"],\"product-manager\":[\"linear\",\"slack\"],\"software-engineer\":[\"figma\",\"vercel\"],\"researcher\":[\"notion-workspace\",\"vercel\"],\"marketer\":[\"slack\",\"notion-workspace\"],\"designer\":[\"figma\",\"vercel\"],\"educator\":[\"notion-workspace\",\"vercel\"],\"operations\":[\"slack\",\"linear\"],\"other\":[\"vercel\",\"supabase\"]},\"byJobRole\":{\"educator\":[{\"description\":\"Notes, examples, and exercises I can edit\",\"title\":\"Plan a lesson\",\"pluginName\":\"notion-workspace\",\"prompt\":\"Help me plan a lesson in Notion. Ask for the topic, level, and length, then draft notes, a couple of worked examples, and exercises with an answer key. Save it somewhere I can edit. If Notion isn’t connected, create it in the chat or as a file in this project.\"},{\"pluginName\":\"vercel\",\"prompt\":\"Help me build a small interactive demo for one class concept and deploy it to Vercel so students can open the link. Ask which concept and how simple it should be. Deploy when ready, or give me another way to share if Vercel isn’t available.\",\"description\":\"Live demo students can open on their phones\",\"title\":\"Deploy my prototype\"},{\"pluginName\":\"context7-plugin\",\"title\":\"Create an assignment with starter code and tests\",\"prompt\":\"Help me create a programming assignment: ask me the topic and level, then generate starter code, hidden tests, and a rubric, using current library versions so nothing is deprecated by the time students run it.\",\"description\":\"N/A\"}],\"software-engineer\":[{\"prompt\":\"Help me turn a Figma design into working UI in this repo. Ask which frame or file to use and how close to match the design. Inspect the repo’s framework and components, implement it, and show me how to view it locally. If you can’t access Figma, ask me to paste a link or screenshot and keep going.\",\"pluginName\":\"figma\",\"title\":\"Build from a design\",\"description\":\"Turn a frame into working UI in this repo\"},{\"description\":\"Put it on a live link anyone can open\",\"prompt\":\"Help me deploy this project to Vercel with a shareable link. Ask what to deploy and any preferences (project name, env). Walk me through login if needed and give me the URL when it’s live. If Vercel isn’t available, suggest another way to host or share a preview.\",\"title\":\"Deploy my prototype\",\"pluginName\":\"vercel\"},{\"title\":\"Pick a ticket and plan the fix in this repo\",\"pluginName\":\"linear\",\"description\":\"N/A\",\"prompt\":\"Find tickets assigned to me and pick one that fits this repo. Turn it into a step-by-step implementation plan with the approach, files to change, and tests to run. If nothing is assigned to me, suggest three small open tickets that fit this repo and recommend one to start with.\"},{\"prompt\":\"Pull the most frequent production errors from the last 24 hours, group them by likely root cause, and trace the top one to the code in this repo that throws it. Tell me what you'd check or fix first. If it's quiet, summarize overall service health instead.\",\"pluginName\":\"datadog\",\"title\":\"Find the top production errors and where they start in the code\",\"description\":\"N/A\"}],\"product-manager\":[{\"description\":\"Turn an active issue into a clear product plan\",\"pluginName\":\"linear\",\"title\":\"Plan the next ticket\",\"prompt\":\"Help me pick up a Linear ticket and turn it into a short plan: problem, requirements, open questions, and next steps. Ask which project or team to look at, or what I’m trying to ship. If nothing’s assigned, suggest a few active ones. If Linear isn’t connected, ask me to paste a ticket and plan from that.\"},{\"title\":\"Catch up on replies\",\"prompt\":\"Help me catch up on Slack messages that need a reply. Ask which channels or people matter most, then summarize what’s waiting on me and draft short replies I can edit. If Slack isn’t connected, ask what to connect or have me paste the threads.\",\"description\":\"Surface mentions and threads waiting on me\",\"pluginName\":\"slack\"},{\"pluginName\":\"amplitude\",\"description\":\"N/A\",\"title\":\"Summarize adoption and drop-off for a feature\",\"prompt\":\"Look at recent usage in Amplitude and summarize adoption and drop-off for a feature: who's picking it up, where people fall out of the flow, and how that changed over the last 30 days. Ask me which feature to look at, or if one stands out in the data, start there and tell me why.\"},{\"pluginName\":\"figma\",\"title\":\"Turn a product mock into a clickable prototype\",\"prompt\":\"Turn a Figma mock into a clickable prototype I can share. Ask me to paste a link to the frame, then build it as a working page and tell me how to view it in the browser.\",\"description\":\"N/A\"}],\"designer\":[{\"description\":\"Turn a frame into clickable UI with real layout\",\"pluginName\":\"figma\",\"prompt\":\"Help me turn one of my Figma designs into working, clickable UI. Ask which frame to use (or to select it in Figma), how faithful to be, and any constraints. Build it, then show me how to open it in the browser. If Figma isn’t connected, ask for a link or export and keep going.\",\"title\":\"Build from a design\"},{\"title\":\"Deploy my prototype\",\"description\":\"Put it on a live link anyone can open\",\"prompt\":\"Help me deploy this prototype to Vercel with a shareable link. Ask what to deploy and any preferences (project name, env). Walk me through login if needed and give me the URL when it’s live. If Vercel isn’t available, suggest another way to host or share a preview.\",\"pluginName\":\"vercel\"},{\"description\":\"N/A\",\"pluginName\":\"linear\",\"title\":\"Fix a UI papercut from my backlog\",\"prompt\":\"Look through my Linear backlog for small UI papercuts — spacing, alignment, colors, empty states, copy tweaks — and pick one that fits this repo. Make the fix, show me a before/after of what changed, and update the ticket so the team knows it's done. If you can't find one, ask me what's been bugging me and we'll fix that instead.\"}],\"student\":[{\"pluginName\":\"vercel\",\"title\":\"Deploy my prototype\",\"prompt\":\"Help me build or finish a simple web app and deploy it to Vercel with a live URL. Ask what I want to make (or suggest a few ideas I could finish today), then deploy and give me the link. If Vercel isn’t available, help me run it locally and share another way.\",\"description\":\"Build something small and share a live link\"},{\"description\":\"Turn a mock into a working app\",\"title\":\"Build from a design\",\"pluginName\":\"figma\",\"prompt\":\"Help me turn a Figma design into a small working app. Ask what to build (or which frame) and how polished it should be. Implement it and show me how to run it. If Figma isn’t connected, sketch from a description I give you.\"},{\"title\":\"Turn notes into a study guide and practice plan\",\"description\":\"N/A\",\"pluginName\":\"notion-workspace\",\"prompt\":\"Search my Notion for class notes on a topic (ask me which), and turn them into a study guide: the key concepts in plain language, five practice problems from easy to hard, and a plan for the week before the exam.\"}],\"other\":[{\"description\":\"Put a project on a shareable live link\",\"prompt\":\"Help me deploy this project to Vercel with a shareable link. Ask what to deploy and any preferences, then walk me through login if needed and give me the URL. If Vercel isn’t available, suggest another way to host or share a preview.\",\"pluginName\":\"vercel\",\"title\":\"Deploy my prototype\"},{\"pluginName\":\"supabase\",\"title\":\"Review my database\",\"description\":\"Check schema, indexes, and risky access rules\",\"prompt\":\"Help me review the Supabase database behind this project. Ask which project or tables to focus on, then check for missing indexes, risky access rules, and schema patterns that could cause bugs or slow queries. Suggest a few concrete improvements. If Supabase isn’t connected, ask me to paste the schema or point at migrations in the repo.\"},{\"pluginName\":\"slack\",\"description\":\"N/A\",\"title\":\"Catch up on messages that need a reply\",\"prompt\":\"Summarize my unread mentions and the threads where someone is waiting on me. Group them by topic, identify the three most urgent, and draft a short reply I can edit for each.\"},{\"prompt\":\"I want to turn a Figma design into a working prototype. Ask me to paste a link to the frame, then build it faithfully and show me how to open it in the browser.\",\"description\":\"N/A\",\"pluginName\":\"figma\",\"title\":\"Turn a design into a working prototype\"},{\"prompt\":\"Find the issues assigned to me in Linear, pick the most active one, and turn it into a concise execution plan with the goal, open questions, steps, and definition of done. If nothing is assigned, suggest three recent issues to start with.\",\"description\":\"N/A\",\"pluginName\":\"linear\",\"title\":\"Turn an assigned issue into a plan\"}],\"researcher\":[{\"pluginName\":\"notion-workspace\",\"title\":\"Synthesize my notes\",\"description\":\"Pull themes, findings, and open questions\",\"prompt\":\"Help me synthesize my Notion research notes into themes, agreements/disagreements, and open questions. Ask which topic or folder to focus on and how deep to go. Cite sources when you can. If Notion isn’t connected, ask me to paste or point at files and continue.\"},{\"title\":\"Deploy my prototype\",\"description\":\"Share a live link for a study flow or results page\",\"pluginName\":\"vercel\",\"prompt\":\"Help me build or finish a simple prototype and deploy it to Vercel with a live URL. Ask what to make (study flow, results page, etc.), then deploy and give me the link. If Vercel isn’t available, help me run it locally and share another way.\"},{\"description\":\"N/A\",\"pluginName\":\"slack\",\"title\":\"Find user evidence hiding in Slack\",\"prompt\":\"Help me find the user evidence buried in Slack. Search the channels where feedback, support issues, and customer conversations land, from the last 30 days. Group what users are struggling with into themes, link the threads as receipts, and tell me which three questions most need real research. If you can't reach my Slack workspace yet, walk me through finishing the connection first.\"}],\"marketer\":[{\"prompt\":\"Help me catch up on Slack messages about campaigns, launches, and customer feedback. Ask which channels or people matter most, then summarize what’s waiting on me and draft short replies I can edit. If Slack isn’t connected, ask what to connect or have me paste the threads.\",\"pluginName\":\"slack\",\"title\":\"Catch up on campaign feedback\",\"description\":\"Surface customer and stakeholder replies waiting on me\"},{\"title\":\"Draft a campaign brief\",\"description\":\"Audience, message, and next steps I can edit\",\"prompt\":\"Help me draft a campaign brief in Notion. Ask what we’re launching, who it’s for, and the goal, then write audience, message, channels, timeline, and open questions. Save it somewhere I can edit. If Notion isn’t connected, create it in the chat or as a file in this project.\",\"pluginName\":\"notion-workspace\"},{\"pluginName\":\"figma\",\"title\":\"Transform a mock into a landing page\",\"description\":\"N/A\",\"prompt\":\"Help me turn a Figma campaign mock into a working landing page I can share. Ask me to paste a link to the frame (or which frame to use), then build it and show me how to open it in the browser. If Figma isn’t connected, ask for a link, export, or a short description and keep going.\"},{\"description\":\"N/A\",\"title\":\"Analyze feature adoption from a recent campaign\",\"pluginName\":\"amplitude\",\"prompt\":\"Help me summarize adoption and drop-off for a campaign or feature in Amplitude. Ask which launch or funnel to look at, then explain who’s picking it up, where people fall out, and what changed recently. If Amplitude isn’t connected, ask me to paste a chart or export and continue.\"}],\"data\":[{\"title\":\"Check feature adoption\",\"pluginName\":\"amplitude\",\"description\":\"See who’s using it and where they drop off\",\"prompt\":\"Help me summarize adoption and drop-off for a feature in Amplitude. Ask which feature or funnel to look at, then explain who’s picking it up, where people fall out, and what changed recently. If Amplitude isn’t connected, ask me to paste a chart or export and continue.\"},{\"prompt\":\"Help me answer a question with Databricks warehouse data. Ask what I’m trying to learn, then look at what’s available and run a clear query (or propose one). Explain the result in plain language. If Databricks isn’t connected, ask me to paste a sample or point at SQL in the repo.\",\"title\":\"Query the warehouse\",\"description\":\"Answer a business question from the data\",\"pluginName\":\"databricks\"},{\"title\":\"Turn a stakeholder question into a notebook I can share\",\"prompt\":\"Help me answer a data question as a Hex notebook I can share. Ask what the question is, then build it: the query, a clean chart, and a one-line takeaway. If there's an existing notebook close to it, build on that.\",\"pluginName\":\"hex\",\"description\":\"N/A\"}],\"operations\":[{\"pluginName\":\"slack\",\"description\":\"Mentions, pages, and threads that need a reply\",\"prompt\":\"Help me triage Slack messages that need a reply — ops requests, pages, and stakeholder asks. Ask which channels matter most, then group what’s waiting on me, flag the three most urgent, and draft short replies I can edit. If Slack isn’t connected, ask what to connect or have me paste the threads.\",\"title\":\"Triage what’s waiting on me\"},{\"pluginName\":\"linear\",\"title\":\"Plan the next ops ticket\",\"description\":\"Turn an active issue into clear next steps\",\"prompt\":\"Help me pick up a Linear ticket and turn it into a short ops plan: problem, owners, steps, and definition of done. Ask which project or team to look at. If nothing’s assigned, suggest a few active ones. If Linear isn’t connected, ask me to paste a ticket and plan from that.\"},{\"description\":\"N/A\",\"title\":\"Turn a runbook into a checklist\",\"prompt\":\"Help me turn a Notion runbook or SOP into a clear checklist I can follow or hand off. Ask which page or process to use, then rewrite it as numbered steps, owners, and what “done” looks like. If Notion isn’t connected, ask me to paste the doc and continue.\",\"pluginName\":\"notion-workspace\"},{\"prompt\":\"Pull recent production errors and alerts from the last 24 hours, group them by likely cause, and tell me what I’d check or fix first. If it’s quiet, summarize overall service health instead. If Datadog isn’t connected, ask me to paste an alert or screenshot and keep going.\",\"pluginName\":\"datadog\",\"title\":\"Find what's paging or erroring\",\"description\":\"N/A\"}]}},\"is_device_based\":false,\"passed\":false},\"2494610143\":{\"name\":\"2494610143\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"group\":\"no_email\"},\"is_device_based\":false,\"group_name\":\"no_email\",\"is_experime