ice_based\":true,\"group_name\":\"Control\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2373006161\":{\"name\":\"2373006161\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2381562381\":{\"name\":\"2381562381\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"index\":\"after-sonnet\"},\"is_device_based\":false,\"passed\":false},\"2382473376\":{\"name\":\"2382473376\",\"rule_id\":\"2OfcQokRT65PvKc6Qk14NP-2OfcQmFPqNWlckEbfc5ruN\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"allowlist\":[\"public.ecr.aws\",\"awscli.amazonaws.com\",\"anaconda.com\",\"azure.com\",\"cloudflarestorage.com\",\"*.cloudflarestorage.com\",\"docker.com\",\"*.docker.com\",\"github.com\",\"codeload.github.com\",\"githubusercontent.com\",\"*.githubusercontent.com\",\"gitlab.com\",\"google.com\",\"dl.google.com\",\"*.googleapis.com\",\"*.gvt1.com\",\"hashicorp.com\",\"java.com\",\"microsoft.com\",\"dotnet.microsoft.com\",\"mcr.microsoft.com\",\"packages.microsoft.com\",\"npmjs.com\",\"oracle.com\",\"ubuntu.com\",\"archive.ubuntu.com\",\"security.ubuntu.com\",\"public.blob.vercel-storage.com\",\"*.public.blob.vercel-storage.com\",\"visualstudio.com\",\"yarnpkg.com\",\"*.yarnpkg.com\",\"pkg.go.dev\",\"*.anysphere.workers.dev\",\"*.jdx.dev\",\"pub.dev\",\"crates.io\",\"index.crates.io\",\"static.crates.io\",\"docker.io\",\"*.docker.io\",\"gcr.io\",\"ghcr.io\",\"goproxy.io\",\"k8s.io\",\"packagecloud.io\",\"pypa.io\",\"quay.io\",\"rvm.io\",\"spring.io\",\"playwright.azureedge.net\",\"dot.net\",\"java.net\",\"launchpad.net\",\"ppa.launchpad.net\",\"sourceforge.net\",\"alpinelinux.org\",\"apache.org\",\"archlinux.org\",\"bitbucket.org\",\"centos.org\",\"cocoapods.org\",\"cpan.org\",\"debian.org\",\"npm.duckdb.org\",\"eclipse.org\",\"fedoraproject.org\",\"golang.org\",\"proxy.golang.org\",\"sum.golang.org\",\"gradle.org\",\"haskell.org\",\"json-schema.org\",\"apt.llvm.org\",\"maven.org\",\"metacpan.org\",\"nodejs.org\",\"npmjs.org\",\"registry.npmjs.org\",\"nuget.org\",\"packagist.org\",\"pypi.org\",\"pypi.python.org\",\"pythonhosted.org\",\"files.pythonhosted.org\",\"ruby-lang.org\",\"rubygems.org\",\"rubyonrails.org\",\"static.rust-lang.org\",\"json.schemastore.org\",\"swift.org\",\"ziglang.org\",\"hex.pm\",\"rustup.rs\",\"sh.rustup.rs\",\"mise.run\",\"*.anysphere.workers.dev\",\"binaries.prisma.sh\",\"fonts.gstatic.com\",\"repo.maven.apache.org\",\"registry.yarnpkg.com\"]},\"is_device_based\":false,\"passed\":false},\"2384782385\":{\"name\":\"2384782385\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"byJobRole\":{\"researcher\":{\"coding\":[{\"type\":\"app\",\"app\":\"figma\",\"title\":\"Build a prototype for the next study\",\"description\":\"Turn a study concept into an interactive experience\",\"prompt\":\"Install the Figma plugin and use its MCP tools to choose a relevant study concept or stimulus, then build a reproducible interactive version in this repo.\"},{\"type\":\"app\",\"description\":\"Turn a recurring question into an analysis\",\"app\":\"slack\",\"title\":\"Investigate a question from Slack\",\"prompt\":\"Install the Slack plugin and use it to find a recurring research or evidence question. Turn it into a concrete, reproducible analysis or experiment in this repo and document the limitations.\"},{\"prompt\":\"Install the Linear plugin and use it to find the highest-priority research request that can be addressed in this repo. Build the smallest reproducible test or analysis that creates useful evidence.\",\"app\":\"linear\",\"type\":\"app\",\"title\":\"Build the top research request\",\"description\":\"Choose a scoped request and create the first test\"},{\"app\":\"notion-workspace\",\"description\":\"Turn a research method into runnable code\",\"title\":\"Reproduce a documented analysis\",\"prompt\":\"Install the Notion plugin and use it to find a documented analysis or method that fits this repo. Reproduce it in code, compare the results with the claims, and document any differences.\",\"type\":\"app\"},{\"title\":\"Turn a hypothesis into an experiment\",\"prompt\":\"Ask me for a hypothesis, then design and build a reproducible first experiment. Define the method, expected result, analysis, and limitations.\",\"icon\":\"terminal\",\"type\":\"icon\",\"description\":\"Design and build a reproducible first test\"},{\"type\":\"icon\",\"description\":\"Run the analysis and document any differences\",\"prompt\":\"Reproduce the main results in this project. Set up and run the analysis, compare the outputs with the documented claims, and record every mismatch or blocker.\",\"icon\":\"magnifying-glass-sparkle\",\"title\":\"Reproduce this project’s results\"},{\"title\":\"Build an interactive research tool\",\"type\":\"icon\",\"description\":\"Turn a research question into an exploratory interface\",\"prompt\":\"Ask me for a research question or dataset, then build a focused interactive tool that makes the important patterns easy to explore and understand.\",\"icon\":\"database\"}],\"tasks\":[{\"type\":\"app\",\"app\":\"figma\",\"description\":\"Find bias, ambiguity, and missing states\",\"title\":\"Review the next study experience\",\"prompt\":\"Install the Figma plugin and use its MCP tools to review a relevant study flow or stimulus. Identify ambiguity, bias, missing states, and anything that could weaken the evidence.\"},{\"app\":\"slack\",\"title\":\"Find the strongest user evidence\",\"description\":\"Group discussions into themes with citations\",\"type\":\"app\",\"prompt\":\"Install the Slack plugin and use it to review recent relevant discussions. Group recurring observations and open questions into themes, cite the strongest evidence, and recommend what to investigate next.\"},{\"type\":\"app\",\"app\":\"linear\",\"prompt\":\"Install the Linear plugin and use it to find the highest-priority research request. Turn it into a focused study plan with the question, method, sample, analysis, risks, and deliverable.\",\"title\":\"Plan the next research study\",\"description\":\"Turn a request into a focused research plan\"},{\"title\":\"Synthesize what you already know\",\"prompt\":\"Install the Notion plugin and use it to find relevant research notes and source materials. Synthesize them into findings, agreements, disagreements, evidence, and the most important open questions.\",\"app\":\"notion-workspace\",\"type\":\"app\",\"description\":\"Combine notes into findings and open questions\"},{\"title\":\"Create a research plan\",\"description\":\"Define the method, sample, and analysis approach\",\"type\":\"icon\",\"icon\":\"plan\",\"prompt\":\"Ask me for the open question, then create a rigorous research plan with the method, sample, materials, analysis approach, risks, and decision it should inform.\"},{\"title\":\"Synthesize these materials\",\"type\":\"icon\",\"prompt\":\"Ask me which materials to use, then synthesize them into themes, agreements, disagreements, supporting evidence, and the most important unanswered questions.\",\"description\":\"Extract themes, evidence, and unanswered questions\",\"icon\":\"magnifying-glass-sparkle\"},{\"description\":\"Find weak assumptions and missing evidence\",\"title\":\"Challenge the current conclusion\",\"prompt\":\"Ask me for the current conclusion, then challenge it constructively. Identify weak assumptions, alternative explanations, missing evidence, and what would change the answer.\",\"icon\":\"list-bullets\",\"type\":\"icon\"}]},\"marketer\":{\"tasks\":[{\"prompt\":\"Install the Figma plugin and use its MCP tools to review a campaign or landing page design. Assess the messaging hierarchy, call to action, and missing states, then list what to fix before launch.\",\"type\":\"app\",\"title\":\"Review a campaign design\",\"description\":\"Check messaging, hierarchy, and gaps\",\"app\":\"figma\"},{\"app\":\"slack\",\"type\":\"app\",\"prompt\":\"Install the Slack plugin and use it to review my recent mentions and threads. Identify what needs a response or action, rank the three most important items, and draft the next step for each.\",\"title\":\"Catch up and prioritize your day\",\"description\":\"Find what needs a reply and rank it\"},{\"app\":\"linear\",\"prompt\":\"Install the Linear plugin and use it to review my assigned issues. Choose the best next one and create a clear plan with the goal, open questions, steps, and definition of done.\",\"type\":\"app\",\"title\":\"Plan your campaign work\",\"description\":\"Turn issues into an ordered plan\"},{\"app\":\"notion-workspace\",\"type\":\"app\",\"title\":\"Turn a brief into a campaign plan\",\"prompt\":\"Install the Notion plugin and use it to find a campaign brief or notes doc. Organize it into clear goals, audience, messaging, channels, and a prioritized list of next steps.\",\"description\":\"Organize notes into goals and next steps\"},{\"prompt\":\"Help me plan a marketing campaign. Ask me the goal and audience, then produce positioning, key messages, channels, a timeline, and an ordered list of next steps.\",\"icon\":\"plan\",\"description\":\"Go from an idea to a launch plan\",\"title\":\"Plan a campaign\",\"type\":\"icon\"},{\"icon\":\"magnifying-glass-sparkle\",\"title\":\"Research your market\",\"description\":\"Understand competitors and positioning\",\"prompt\":\"Research a market or competitor set I give you. Summarize how they position themselves, where the gaps are, and what messaging would differentiate us. Cite your sources.\",\"type\":\"icon\"},{\"prompt\":\"Ask me what is on my plate this week, then organize it into a prioritized plan with the most important items first, realistic time estimates, and a clear next action for each.\",\"title\":\"Organize your week\",\"type\":\"icon\",\"icon\":\"list-bullets\",\"description\":\"Turn everything on your plate into a plan\"}],\"coding\":[{\"app\":\"figma\",\"type\":\"app\",\"description\":\"Build a real page from an existing design\",\"prompt\":\"Install the Figma plugin and use its MCP tools to choose a landing page or marketing frame, then build it faithfully in this repo using the existing components. Run it locally and show me the result.\",\"title\":\"Turn a design into a landing page\"},{\"type\":\"app\",\"title\":\"Build what the team asked for\",\"description\":\"Turn a Slack request into a working page\",\"prompt\":\"Install the Slack plugin and use it to find a concrete marketing or website request that fits this repo. Build the smallest useful version and explain how to preview it.\",\"app\":\"slack\"},{\"type\":\"app\",\"title\":\"Ship a marketing site issue\",\"app\":\"linear\",\"prompt\":\"Install the Linear plugin and use it to find a small website or marketing issue that fits this repo. Implement it end to end and explain how to verify the change.\",\"description\":\"Pick a small site task and complete it\"},{\"prompt\":\"Install the Notion plugin and use it to find a campaign brief or content plan that fits this repo. Turn it into a working page and explain how to run and edit it.\",\"title\":\"Build a page from your brief\",\"type\":\"app\",\"app\":\"notion-workspace\",\"description\":\"Turn a campaign doc into a live page\"},{\"prompt\":\"Give me a non-technical tour of this project. Explain what it does, where the content and copy live, how to run it locally, and the safest first change I could make.\",\"description\":\"Understand the site and where content lives\",\"title\":\"Learn what this project does\",\"icon\":\"terminal\",\"type\":\"icon\"},{\"description\":\"Make one page clearer and more persuasive\",\"type\":\"icon\",\"icon\":\"brush\",\"prompt\":\"Pick one user-facing page in this repo. Improve its copy and layout for clarity and persuasion while matching the existing design system, then show me a before and after.\",\"title\":\"Improve a page's copy and layout\"},{\"prompt\":\"Find one small, safe improvement to this site that would meaningfully help conversion or clarity. Implement it completely and explain how to verify the result.\",\"icon\":\"plan\",\"description\":\"Find one high-impact change and make it\",\"title\":\"Ship a quick site improvement\",\"type\":\"icon\"}]},\"data-scientist\":{\"tasks\":[{\"type\":\"app\",\"title\":\"Audit a dashboard for clarity\",\"prompt\":\"Install the Figma plugin and use its MCP tools to review a relevant dashboard or data view. Identify misleading encodings, unclear hierarchy, missing context, and the most important improvements.\",\"app\":\"figma\",\"description\":\"Find misleading charts and missing context\"},{\"app\":\"slack\",\"description\":\"Investigate a metric discussion and rank the drivers\",\"type\":\"app\",\"title\":\"Explain what changed and why\",\"prompt\":\"Install the Slack plugin and use it to find a recent metric-change discussion. Clarify the question, investigate the likely drivers with available evidence, and summarize the conclusion and caveats.\"},{\"description\":\"Define questions, data needs, and analysis steps\",\"type\":\"app\",\"app\":\"linear\",\"title\":\"Plan an incoming data request\",\"prompt\":\"Install the Linear plugin and use it to find the highest-priority data request. Turn it into an analysis plan with clarifying questions, required data, method, checks, and deliverable.\"},{\"app\":\"notion-workspace\",\"title\":\"Turn analysis into a decision brief\",\"prompt\":\"Install the Notion plugin and use it to find a recent analysis. Turn it into a decision-ready brief with the question, method, finding, caveats, recommendation, and next steps.\",\"type\":\"app\",\"description\":\"Summarize findings, caveats, and recommendations\"},{\"type\":\"icon\",\"title\":\"Answer a business question\",\"prompt\":\"Ask me for the business question and decision it should inform. Then identify the available data, perform the strongest feasible analysis, and explain the result and caveats clearly.\",\"description\":\"Clarify the decision and explain the result\",\"icon\":\"database\"},{\"type\":\"icon\",\"icon\":\"magnifying-glass-sparkle\",\"title\":\"Explain what changed and why\",\"description\":\"Investigate a movement and rank its likely drivers\",\"prompt\":\"Ask me which metric or result changed, then investigate it systematically. Quantify the movement, test likely drivers, and rank the explanations with evidence and caveats.\"},{\"icon\":\"plan\",\"title\":\"Turn analysis into a decision brief\",\"description\":\"Summarize findings, caveats, and next steps\",\"prompt\":\"Ask me which analysis to use, then turn it into a decision-ready brief with the question, method, finding, caveats, recommendation, and next steps.\",\"type\":\"icon\"}],\"coding\":[{\"title\":\"Build a dashboard from a design\",\"app\":\"figma\",\"type\":\"app\",\"description\":\"Turn a data view into working, interactive UI\",\"prompt\":\"Install the Figma plugin and use its MCP tools to choose a relevant data visualization or dashboard frame, then implement it in this repo with realistic states and interactions.\"},{\"title\":\"Investigate an anomaly from Slack\",\"type\":\"app\",\"prompt\":\"Install the Slack plugin and use it to find a concrete metric anomaly or data question. Reproduce the issue in this repo, test the likely drivers, and document the evidence and caveats.\",\"app\":\"slack\",\"description\":\"Turn a reported change into reproducible analysis\"},{\"prompt\":\"Install the Linear plugin and use it to find a well-scoped data issue that fits this repo. Trace the root cause, implement a reliable fix, and add the most relevant validation.\",\"type\":\"app\",\"app\":\"linear\",\"title\":\"Fix a data issue from the backlog\",\"description\":\"Diagnose a scoped problem and implement the fix\"},{\"title\":\"Trace a documented metric\",\"description\":\"Map its definition from raw data to final output\",\"type\":\"app\",\"app\":\"notion-workspace\",\"prompt\":\"Install the Notion plugin and use it to find an important metric definition that is implemented in this repo. Trace it from raw inputs to final output, fix any clear mismatch, and document the assumptions.\"},{\"icon\":\"database\",\"title\":\"Trace a metric end to end\",\"type\":\"icon\",\"description\":\"Map raw data to the final reported number\",\"prompt\":\"Find an important metric in this project and trace it from raw inputs to the final reported number. Show each transformation, assumption, and place it is consumed.\"},{\"title\":\"Find a suspicious result\",\"type\":\"icon\",\"icon\":\"magnifying-glass-sparkle\",\"prompt\":\"Inspect this analysis or model for a suspicious result. Check for data leakage, incorrect joins, biased samples, invalid assumptions, and implementation mistakes, then verify the strongest finding.\",\"description\":\"Check for anomalies, leakage, and bad assumptions\"},{\"title\":\"Turn this notebook into production code\",\"type\":\"icon\",\"prompt\":\"Find the main exploratory analysis in this project and turn it into reliable, testable production code with clear inputs, outputs, validation, and documentation.\",\"description\":\"Build a reliable, testable analysis pipeline\",\"icon\":\"terminal\"}]},\"operations\":{\"coding\":[{\"description\":\"Build a working version of a proposed screen\",\"type\":\"app\",\"prompt\":\"Install the Figma plugin and use its MCP tools to choose an internal tool or dashboard design, then build a faithful working version in this repo and show me how to run it.\",\"title\":\"Turn a design into an internal tool\",\"app\":\"figma\"},{\"title\":\"Automate a request from Slack\",\"prompt\":\"Install the Slack plugin and use it to find a recurring manual request that fits this repo. Build a small script or tool that automates it and explain how to run it safely.\",\"type\":\"app\",\"app\":\"slack\",\"description\":\"Turn a recurring ask into a script or tool\"},{\"type\":\"app\",\"prompt\":\"Install the Linear plugin and use it to find a small operational issue that fits this repo. Implement it end to end and run the most relevant verification.\",\"app\":\"linear\",\"title\":\"Ship an operational issue\",\"description\":\"Pick a small issue and complete it\"},{\"app\":\"notion-workspace\",\"title\":\"Turn a runbook into a tool\",\"prompt\":\"Install the Notion plugin and use it to find a runbook or documented manual process that fits this repo. Turn the most repetitive part into a working script and explain how to run it.\",\"description\":\"Automate a documented manual process\",\"type\":\"app\"},{\"prompt\":\"Give me a tour of this codebase from an operations perspective. Explain what it does, how to run it, where the configuration and scripts live, and what is risky to change.\",\"icon\":\"terminal\",\"title\":\"Learn this codebase\",\"type\":\"icon\",\"description\":\"Understand the systems and how to run them\"},{\"icon\":\"database\",\"title\":\"Build a report from the data\",\"description\":\"Turn raw data into a usable summary\",\"type\":\"icon\",\"prompt\":\"Find the data available in this project and build a small script that produces a useful operational summary. Explain how to run it and how to read the output.\"},{\"description\":\"Find one manual step and script it\",\"type\":\"icon\",\"icon\":\"plan\",\"title\":\"Automate a repetitive task\",\"prompt\":\"Find one repetitive manual step in this project and automate it with a small, safe script. Implement it completely and explain how to verify the result.\"}],\"tasks\":[{\"type\":\"app\",\"app\":\"figma\",\"description\":\"Check the flow for gaps and failure cases\",\"title\":\"Review a process design\",\"prompt\":\"Install the Figma plugin and use its MCP tools to review a workflow or internal tool design. Identify unclear steps, missing states, and failure cases, then list what to resolve before rollout.\"},{\"title\":\"Catch up and prioritize your day\",\"description\":\"Find what needs a reply and rank it\",\"prompt\":\"Install the Slack plugin and use it to review my recent mentions and threads. Identify what needs a response or action, rank the three most important items, and draft the next step for each.\",\"type\":\"app\",\"app\":\"slack\"},{\"type\":\"app\",\"app\":\"linear\",\"description\":\"Turn issues into an ordered plan\",\"prompt\":\"Install the Linear plugin and use it to review my assigned issues. Choose the best next one and create a clear plan with the goal, open questions, steps, and definition of done.\",\"title\":\"Plan your operational work\"},{\"prompt\":\"Install the Notion plugin and use it to find notes on a process I own. Turn them into a clear runbook with prerequisites, ordered steps, failure cases, and who to escalate to.\",\"title\":\"Turn notes into a runbook\",\"description\":\"Organize a process into clear steps\",\"type\":\"app\",\"app\":\"notion-workspace\"},{\"title\":\"Plan a process rollout\",\"description\":\"Go from a change to an ordered rollout plan\",\"prompt\":\"Help me plan an operational rollout. Ask me what is changing and who it affects, then produce goals, risks, a communication plan, and an ordered list of next steps.\",\"type\":\"icon\",\"icon\":\"plan\"},{\"prompt\":\"Help me investigate a recurring operational problem I describe. Ask clarifying questions, work through likely root causes, and propose a concrete fix with how to verify it.\",\"description\":\"Find the root cause and propose a fix\",\"title\":\"Investigate a recurring problem\",\"type\":\"icon\",\"icon\":\"magnifying-glass-sparkle\"},{\"description\":\"Turn everything on your plate into a plan\",\"prompt\":\"Ask me what is on my plate this week, then organize it into a prioritized plan with the most important items first, realistic time estimates, and a clear next action for each.\",\"type\":\"icon\",\"icon\":\"list-bullets\",\"title\":\"Organize your week\"}]},\"student\":{\"tasks\":[{\"app\":\"figma\",\"type\":\"app\",\"title\":\"Understand a design before building\",\"description\":\"Break a design into clear build steps\",\"prompt\":\"Install the Figma plugin and use its MCP tools to review a design. Explain what it is asking for, list the pieces to build, flag anything unclear, and give me an ordered plan.\"},{\"title\":\"Catch up on what you missed\",\"type\":\"app\",\"app\":\"slack\",\"description\":\"Summarize threads and what needs a reply\",\"prompt\":\"Install the Slack plugin and use it to review my recent mentions and threads. Summarize what happened, identify what needs a response, and draft the next step for each.\"},{\"title\":\"Plan your assigned work\",\"description\":\"Turn issues into an ordered plan\",\"app\":\"linear\",\"prompt\":\"Install the Linear plugin and use it to review my assigned issues. Pick the best next one and write a clear plan with the goal, open questions, steps, and definition of done.\",\"type\":\"app\"},{\"prompt\":\"Install the Notion plugin and use it to find my notes on a current project or course. Organize them into clear goals, open questions, and a prioritized list of next steps.\",\"type\":\"app\",\"description\":\"Organize scattered notes into next steps\",\"app\":\"notion-workspace\",\"title\":\"Turn notes into a study or work plan\"},{\"type\":\"icon\",\"description\":\"Go from a rough idea to an ordered plan\",\"prompt\":\"Help me plan a project from a rough idea. Ask me what I am trying to build, then produce clear goals, milestones, risks, and an ordered list of next steps.\",\"icon\":\"plan\",\"title\":\"Plan a project from scratch\"},{\"title\":\"Research a topic\",\"prompt\":\"Research a topic I give you and produce a structured summary: what it is, why it matters, the key approaches and trade-offs, and where to read more. Cite your sources.\",\"icon\":\"magnifying-glass-sparkle\",\"description\":\"Get a structured summary with sources\",\"type\":\"icon\"},{\"description\":\"Turn everything on your plate into a plan\",\"type\":\"icon\",\"title\":\"Organize your week\",\"prompt\":\"Ask me what is on my plate this week, then organize it into a prioritized plan with the most important items first, realistic time estimates, and a clear next action for each.\",\"icon\":\"list-bullets\"}],\"coding\":[{\"type\":\"app\",\"app\":\"figma\",\"title\":\"Turn a design into working code\",\"prompt\":\"Install the Figma plugin and use its MCP tools to pick a screen, then implement it in this repo using the existing components. Run it locally and walk me through how it works.\",\"description\":\"Build a real, running version of a screen\"},{\"type\":\"app\",\"app\":\"slack\",\"prompt\":\"Install the Slack plugin and use it to find a concrete request that fits this repo. Reduce it to the smallest useful version, build it, and explain each part as you go.\",\"title\":\"Build something asked for in Slack\",\"description\":\"Turn a request into working code\"},{\"type\":\"app\",\"description\":\"Pick a small issue and complete it\",\"app\":\"linear\",\"title\":\"Finish an assigned issue\",\"prompt\":\"Install the Linear plugin and use it to find a small issue assigned to me. Implement it end to end, run the most relevant check, and explain the changes so I learn from them.\"},{\"prompt\":\"Install the Notion plugin and use it to find a project or assignment idea that fits this repo. Build the smallest working version and explain how to run and extend it.\",\"description\":\"Turn a class or side project into code\",\"app\":\"notion-workspace\",\"type\":\"app\",\"title\":\"Build a project from your notes\"},{\"description\":\"Get a guided tour of how it all fits together\",\"prompt\":\"Give me a beginner-friendly tour of this codebase. Explain the architecture, the main flows, how to run it, and the best first change to make. Cite the specific files that matter.\",\"type\":\"icon\",\"icon\":\"terminal\",\"title\":\"Learn this codebase\"},{\"icon\":\"magnifying-glass-sparkle\",\"description\":\"Trace a defect and fix it with an explanation\",\"type\":\"icon\",\"title\":\"Find and fix a real bug\",\"prompt\":\"Find a likely real bug in this codebase. Explain the root cause in plain language, implement a focused fix, and verify it with the most relevant test or check.\"},{\"prompt\":\"Suggest three small features that fit this project and are good for learning. Recommend the best one, then build it step by step and explain your reasoning as you go.\",\"description\":\"Pick a small feature and ship it step by step\",\"icon\":\"plan\",\"type\":\"icon\",\"title\":\"Build your first feature\"}]},\"something-else\":{\"coding\":[{\"type\":\"app\",\"title\":\"Turn a design into a working app\",\"prompt\":\"Install the Figma plugin and use its MCP tools to choose a relevant design, then turn it into a faithful, working experience in this repo and show me how to run it.\",\"description\":\"Build a faithful, clickable version in this repo\",\"app\":\"figma\"},{\"app\":\"slack\",\"title\":\"Build a request from Slack\",\"prompt\":\"Install the Slack plugin and use it to find a concrete request that fits this repo. Reduce it to a focused first version, build it, and explain how to verify it.\",\"description\":\"Turn a concrete request into a working demo\",\"type\":\"app\"},{\"title\":\"Ship a quick win\",\"description\":\"Find a small issue and implement it completely\",\"type\":\"app\",\"prompt\":\"Install the Linear plugin and use it to find a small, valuable issue that fits this repo. Implement it end to end and run the most relevant verification.\",\"app\":\"linear\"},{\"prompt\":\"Install the Notion plugin and use it to find a promising concrete idea that fits this repo. Build the smallest useful version and show me how to try it.\",\"type\":\"app\",\"app\":\"notion-workspace\",\"description\":\"Turn a promising idea into a working first version\",\"title\":\"Build an idea from your notes\"},{\"description\":\"Explain what this project does and how it connects\",\"icon\":\"magnifying-glass-sparkle\",\"prompt\":\"Give me a five-minute tour of this project. Explain what it does, how its main pieces connect, how to run it, and where a newcomer should start.\",\"title\":\"Give me the five-minute tour\",\"type\":\"icon\"},{\"title\":\"Turn an idea into a working app\",\"type\":\"icon\",\"icon\":\"terminal\",\"prompt\":\"Suggest three useful app ideas that fit this project and can be completed quickly. Recommend the strongest one, then build it after I choose.\",\"description\":\"Suggest three useful ideas, then build one\"},{\"type\":\"icon\",\"icon\":\"plan\",\"title\":\"Find and ship a quick win\",\"description\":\"Identify one safe improvement and complete it\",\"prompt\":\"Find one small, safe improvement that would make this project meaningfully better. Implement it completely and explain how to verify the result.\"}],\"tasks\":[{\"type\":\"app\",\"title\":\"Review a concept before building\",\"prompt\":\"Install the Figma plugin and use its MCP tools to review a relevant concept. Identify unclear flows, missing states, risky assumptions, and the questions to answer before building.\",\"app\":\"figma\",\"description\":\"Find unclear flows, missing states, and risks\"},{\"title\":\"Catch up and prioritize your day\",\"prompt\":\"Install the Slack plugin and use it to review my recent mentions and threads. Identify what needs a response or action, rank the three most important items, and draft the next step for each.\",\"type\":\"app\",\"app\":\"slack\",\"description\":\"Find messages awaiting a response and rank them\"},{\"prompt\":\"Install the Linear plugin and use it to review my assigned issues. Choose the best next one and create a clear execution plan with the goal, open questions, steps, and definition of done.\",\"description\":\"Choose the best next issue and create a plan\",\"title\":\"Make progress on an assigned issue\",\"app\":\"linear\",\"type\":\"app\"},{\"title\":\"Turn scattered notes into a plan\",\"app\":\"notion-workspace\",\"description\":\"Organize an idea into goals and next steps\",\"type\":\"app\",\"prompt\":\"Install the Notion plugin and use it to find an active idea or project. Organize it into a clear plan with the goal, decisions, risks, priorities, and immediate next steps.\"},{\"icon\":\"list-bullets\",\"description\":\"Turn the goal into a prioritized action plan\",\"type\":\"icon\",\"title\":\"Help me decide what to do next\",\"prompt\":\"Ask me what I am trying to accomplish and what constraints matter. Then create a short, prioritized action plan and recommend the best first step.\"},{\"type\":\"icon\",\"icon\":\"plan\",\"title\":\"Turn a messy idea into a clear plan\",\"description\":\"Structure the goal, decisions, risks, and next steps\",\"prompt\":\"Ask me to describe the idea in whatever form I have. Turn it into a clear plan with the goal, decisions, assumptions, risks, milestones, and immediate next steps.\"},{\"title\":\"Automate something repetitive\",\"type\":\"icon\",\"icon\":\"terminal\",\"prompt\":\"Ask me about a repetitive task I do often. Design the simplest safe automation for it, build what is feasible, and show me how to use it.\",\"description\":\"Find a recurring workflow and make it simpler\"}]},\"software-engineer\":{\"coding\":[{\"app\":\"figma\",\"type\":\"app\",\"title\":\"Turn a design into working UI\",\"description\":\"Build a frame with this repo’s existing components\",\"prompt\":\"Install the Figma plugin and use its MCP tools to help me choose a frame, then implement it faithfully in this repo using the existing components and patterns. Run it locally and show me what changed.\"},{\"app\":\"slack\",\"title\":\"Fix a bug from Slack\",\"description\":\"Trace a recent bug report to code and fix it\",\"prompt\":\"Install the Slack plugin and use it to find a recent concrete bug report that fits this repo. Trace it to the responsible code, implement a focused fix, and verify the result.\",\"type\":\"app\"},{\"app\":\"linear\",\"description\":\"Pick a fitting issue and implement it end to end\",\"prompt\":\"Install the Linear plugin and use it to find the issues assigned to me. Choose one that fits this repo and is safe to start, then implement it and run the most relevant verification.\",\"title\":\"Ship an assigned ticket\",\"type\":\"app\"},{\"title\":\"Build an idea from your docs\",\"type\":\"app\",\"prompt\":\"Install the Notion plugin and use it to find a concrete product or engineering idea that fits this repo. Turn it into a focused implementation, build it, and explain how to verify it.\",\"app\":\"notion-workspace\",\"description\":\"Turn a documented idea into a working change\"},{\"type\":\"icon\",\"icon\":\"terminal\",\"title\":\"Map this codebase\",\"prompt\":\"Give me a tour of this codebase. Explain the architecture, main flows, how to run it, and the best place to make a first change. Cite the specific files that matter.\",\"description\":\"Explain the architecture, key flows, and where to start\"},{\"icon\":\"magnifying-glass-sparkle\",\"type\":\"icon\",\"description\":\"Identify a likely defect, trace its cause, and fix it\",\"prompt\":\"Inspect this codebase for a likely real bug. Trace the root cause, implement a focused fix, and verify the behavior with the most relevant test or check.\",\"title\":\"Find and fix a real bug\"},{\"prompt\":\"Find a small, valuable improvement that fits this codebase and can be completed safely. Implement it end to end and explain how to verify it.\",\"description\":\"Find a small valuable improvement and build it end to end\",\"type\":\"icon\",\"icon\":\"plan\",\"title\":\"Ship a quick win\"}],\"tasks\":[{\"title\":\"Plan a design implementation\",\"prompt\":\"Install the Figma plugin and use its MCP tools to choose a relevant frame, then create an implementation plan for this repo, including reusable components, files to change, states, edge cases, and tests.\",\"description\":\"Map a frame to components, files, and edge cases\",\"type\":\"app\",\"app\":\"figma\"},{\"type\":\"app\",\"prompt\":\"Install the Slack plugin and use it to review my recent mentions and engineering threads. Summarize what needs attention, identify blockers and decisions, and give me a prioritized action list.\",\"description\":\"Summarize urgent threads, reviews, and decisions\",\"title\":\"Catch up on engineering\",\"app\":\"slack\"},{\"app\":\"linear\",\"title\":\"Plan your best next ticket\",\"prompt\":\"Install the Linear plugin and use it to review my assigned issues. Choose the best one for this repo and create a concrete plan with the approach, files to change, risks, and tests.\",\"type\":\"app\",\"description\":\"Choose an issue and map the approach and tests\"},{\"app\":\"notion-workspace\",\"type\":\"app\",\"description\":\"Convert an idea into concrete engineering steps\",\"prompt\":\"Install the Notion plugin and use it to find an active engineering idea or technical note that fits this repo. Turn it into a prioritized execution plan with open questions, milestones, and verification.\",\"title\":\"Turn notes into an execution plan\"},{\"description\":\"Map an idea into an approach, files, and tests\",\"title\":\"Plan the next change\",\"type\":\"icon\",\"icon\":\"plan\",\"prompt\":\"Ask me what I want to change, then turn it into a concrete implementation plan with the approach, files to modify, edge cases, and tests to run.\"},{\"type\":\"icon\",\"icon\":\"magnifying-glass-sparkle\",\"title\":\"Review this project’s health\",\"prompt\":\"Review this project for its highest-impact reliability, security, and maintenance risks. Rank the findings, cite the relevant code, and recommend what to address first.\",\"description\":\"Find the biggest reliability and maintenance risks\"},{\"prompt\":\"Find the most important workflow in this project that is missing or poorly documented. Write clear documentation with setup, usage, and troubleshooting guidance.\",\"title\":\"Write the missing documentation\",\"type\":\"icon\",\"icon\":\"list-bullets\",\"description\":\"Find the most confusing workflow and explain it clearly\"}]},\"designer\":{\"coding\":[{\"title\":\"Bring a Figma frame to life\",\"description\":\"Build a faithful, clickable version in this repo\",\"type\":\"app\",\"app\":\"figma\",\"prompt\":\"Install the Figma plugin and use its MCP tools to help me choose a frame, then build it faithfully in this repo with real layout, text, states, and interactions. Run it locally when finished.\"},{\"app\":\"slack\",\"prompt\":\"Install the Slack plugin and use it to find recent actionable design feedback that applies to this product. Choose the highest-impact item and implement the improvement in this repo.\",\"description\":\"Find recent critique and improve the implementation\",\"title\":\"Apply the strongest design feedback\",\"type\":\"app\"},{\"type\":\"app\",\"app\":\"linear\",\"title\":\"Fix a UI papercut\",\"description\":\"Find a small design issue and ship the improvement\",\"prompt\":\"Install the Linear plugin and use it to find a small, well-scoped UI issue that fits this repo. Implement the fix with polished states and interactions, then show me how to verify it.\"},{\"type\":\"app\",\"description\":\"Turn a documented concept into clickable UI\",\"prompt\":\"Install the Notion plugin and use it to find a concrete design brief or concept that fits this product. Build a focused, clickable version using the repo’s existing components and visual language.\",\"title\":\"Build a concept from a design brief\",\"app\":\"notion-workspace\"},{\"title\":\"Make this interface feel finished\",\"icon\":\"brush\",\"description\":\"Polish the weakest screen, states, and interactions\",\"prompt\":\"Inspect the product UI, identify the screen that feels least finished, and polish its layout, states, interactions, accessibility, and visual consistency. Show me what changed.\",\"type\":\"icon\"},{\"description\":\"Turn an idea into working, clickable UI\",\"prompt\":\"Ask me for a product experience I want to create, then build a focused, clickable version using this project's existing components and visual patterns.\",\"title\":\"Build a new experience\",\"type\":\"icon\",\"icon\":\"terminal\"},{\"type\":\"icon\",\"title\":\"Audit the design system\",\"icon\":\"magnifying-glass-sparkle\",\"description\":\"Find inconsistent styles and components worth fixing\",\"prompt\":\"Audit this product's UI implementation for inconsistent spacing, typography, colors, components, and interaction patterns. Rank the most visible issues and fix the strongest candidate.\"}],\"tasks\":[{\"app\":\"figma\",\"title\":\"Audit a design for consistency\",\"description\":\"Find spacing, style, and component inconsistencies\",\"prompt\":\"Install the Figma plugin and use its MCP tools to review a relevant design for inconsistent spacing, typography, styles, components, and states. Rank the issues and recommend what to fix first.\",\"type\":\"app\"},{\"app\":\"slack\",\"title\":\"Turn critique into decisions\",\"description\":\"Summarize feedback, open questions, and next steps\",\"prompt\":\"Install the Slack plugin and use it to find recent design critique. Turn it into a concise decision summary: themes, decisions, unresolved questions, and prioritized next steps.\",\"type\":\"app\"},{\"type\":\"app\",\"description\":\"Turn design work into buildable, scoped tickets\",\"prompt\":\"Install the Linear plugin and use it to review the active design work. Create or improve the handoff: behavior, states, edge cases, accessibility, acceptance criteria, and dependencies.\",\"app\":\"linear\",\"title\":\"Create an engineering handoff\"},{\"prompt\":\"Install the Notion plugin and use it to find recent design feedback and critique notes. Group them into themes, identify conflicts, and recommend the highest-impact actions.\",\"app\":\"notion-workspace\",\"title\":\"Make sense of design feedback\",\"description\":\"Synthesize feedback into themes and actions\",\"type\":\"app\"},{\"title\":\"Critique this experience\",\"icon\":\"brush\",\"prompt\":\"Review the product's main user flow as a design critic. Identify the most confusing or frustrating moments, explain why they matter, and recommend the highest-impact improvements.\",\"type\":\"icon\",\"description\":\"Find the highest-impact usability improvements\"},{\"icon\":\"plan\",\"title\":\"Create an engineering handoff\",\"prompt\":\"Ask me which experience I am handing off, then create an engineering-ready specification covering behavior, states, edge cases, accessibility, and acceptance criteria.\",\"description\":\"Define states, edge cases, and acceptance criteria\",\"type\":\"icon\"},{\"description\":\"Highlight confusing, broken, or missing moments\",\"type\":\"icon\",\"prompt\":\"Map the main user journey through this product from entry to success. Highlight confusing, broken, or missing moments and recommend what to improve first.\",\"icon\":\"list-bullets\",\"title\":\"Map the user journey\"}]},\"product-manager\":{\"coding\":[{\"prompt\":\"Install the Figma plugin and use its MCP tools to help me choose a product mock, then build the smallest faithful prototype in this repo and show me how to run and share it.\",\"app\":\"figma\",\"type\":\"app\",\"title\":\"Turn a mock into a live prototype\",\"description\":\"Build a clickable version that is ready to share\"},{\"title\":\"Prototype a customer request\",\"type\":\"app\",\"description\":\"Turn a recurring request into a working demo\",\"app\":\"slack\",\"prompt\":\"Install the Slack plugin and use it to find a concrete recurring product request that fits this repo. Reduce it to the smallest testable version and build a working prototype.\"},{\"type\":\"app\",\"description\":\"Choose an active feature and implement its core value\",\"title\":\"Build the smallest useful slice\",\"prompt\":\"Install the Linear plugin and use it to find an active product issue that fits this repo. Identify the smallest implementation that tests its core value, then build and verify it.\",\"app\":\"linear\"},{\"app\":\"notion-workspace\",\"title\":\"Turn a product idea into a prototype\",\"description\":\"Build the strongest documented idea as a demo\",\"prompt\":\"Install the Notion plugin and use it to find a promising product idea or brief that fits this repo. Reduce it to the smallest useful prototype and build it.\",\"type\":\"app\"},{\"description\":\"Turn an idea into a working prototype\",\"icon\":\"terminal\",\"prompt\":\"Ask me for a product idea, reduce it to the smallest version that can test the core assumption, and build a working prototype in this project.\",\"type\":\"icon\",\"title\":\"Build the smallest testable version\"},{\"description\":\"Map the main user flows to the code in plain language\",\"prompt\":\"Explain how this product works in plain language. Map the main user flows to the code, show where key decisions happen, and call out what looks easy or difficult to change.\",\"icon\":\"magnifying-glass-sparkle\",\"title\":\"Show me how this product works\",\"type\":\"icon\"},{\"icon\":\"plan\",\"description\":\"Find a clear opportunity and implement it\",\"type\":\"icon\",\"prompt\":\"Inspect the current product and identify one small, clear user-facing improvement. Explain why it matters, implement it, and show me how to verify it.\",\"title\":\"Make one product improvement\"}],\"tasks\":[{\"title\":\"Pressure-test a product mock\",\"description\":\"Find unclear flows, assumptions, and missing states\",\"prompt\":\"Install the Figma plugin and use its MCP tools to review a relevant product mock. Identify unclear flows, hidden assumptions, missing states, and the questions that should be answered before building.\",\"type\":\"app\",\"app\":\"figma\"},{\"app\":\"slack\",\"title\":\"Find the decision blocking the team\",\"description\":\"Surface unresolved discussions and recommend a path\",\"type\":\"app\",\"prompt\":\"Install the Slack plugin and use it to review recent product discussions. Find the most important unresolved decision, summarize the evidence and tradeoffs, and recommend a path forward.\"},{\"title\":\"Draft a spec from active work\",\"prompt\":\"Install the Linear plugin and use it to find the most active relevant project or issue. Draft a concise product spec with the problem, scope, requirements, open questions, and success criteria.\",\"type\":\"app\",\"app\":\"linear\",\"description\":\"Create requirements, questions, and success criteria\"},{\"type\":\"app\",\"prompt\":\"Install the Notion plugin and use it to find recent customer feedback and research notes. Synthesize them into ranked problem themes with evidence and recommend which one to pursue first.\",\"app\":\"notion-workspace\",\"title\":\"Rank the problems customers mention\",\"description\":\"Synthesize feedback into prioritized themes\"},{\"type\":\"icon\",\"description\":\"Define requirements, questions, and success criteria\",\"title\":\"Draft a product spec\",\"icon\":\"plan\",\"prompt\":\"Ask me for a rough product idea, then draft a concise spec with the problem, target user, requirements, non-goals, open questions, risks, and success criteria.\"},{\"description\":\"Rank the most valuable improvements to this product\",\"title\":\"Find the biggest product opportunity\",\"prompt\":\"Inspect this product and rank the most valuable improvement opportunities. Ground each one in the current experience and recommend the smallest strong bet.\",\"type\":\"icon\",\"icon\":\"magnifying-glass-sparkle\"},{\"icon\":\"list-bullets\",\"description\":\"Surface assumptions, risks, and a smaller first version\",\"prompt\":\"Ask me for a feature idea, then pressure-test it. Surface hidden assumptions, user and technical risks, edge cases, and a smaller first version that still tests the core value.\",\"title\":\"Pressure-test a feature idea\",\"type\":\"icon\"}]}}},\"is_device_based\":false,\"passed\":false},\"2390877993\":{\"name\":\"2390877993\",\"rule_id\":\"default\",\"se