04679\":{\"name\":\"3463304679\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"teamID\",\"value\":{\"group\":\"control\"},\"is_device_based\":false,\"group_name\":\"Control\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3464258488\":{\"name\":\"3464258488\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"group\":\"Control\"},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3470779845\":{\"name\":\"3470779845\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"dummy\":\"\"},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3472991935\":{\"name\":\"3472991935\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"stackTraceLimitFloor\":0},\"is_device_based\":false,\"passed\":false},\"3474093626\":{\"name\":\"3474093626\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"timeout_ms\":40000},\"is_device_based\":false,\"passed\":false},\"3477538629\":{\"name\":\"3477538629\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"promptTemplate\":\"You are evaluating whether an active Cursor /goal condition has been satisfied by the conversation transcript.\\n\\nUse the session_goal.condition and transcript_excerpt fields from $ARGUMENTS as evidence.\\nReturn { \\\"ok\\\": true } only if the transcript clearly satisfies the condition.\\nIf the condition is not satisfied yet, return { \\\"ok\\\": false, \\\"reason\\\": \\\"...\\\" } with a concise next-step reason.\"},\"is_device_based\":false,\"passed\":false},\"3483807872\":{\"name\":\"3483807872\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3485673422\":{\"name\":\"3485673422\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"rolesToItems\":{\"Software Engineer\":[{\"prompt\":\"Find the tickets assigned to me and pick one that fits this repo. Turn it into a step-by-step implementation plan with the approach, files to change, and tests to run. If nothing is assigned to me, suggest three small open tickets that fit this repo and recommend one to start with.\",\"subtitle\":\"Pick a ticket and plan the fix in this repo\",\"title\":\"Plan a ticket\",\"pluginKey\":\"jira\"},{\"pluginKey\":\"datadog\",\"title\":\"Investigate errors\",\"prompt\":\"Pull the most frequent production errors from the last 24 hours, group them by likely root cause, and trace the top one to the code in this repo that throws it. Tell me what you'd check or fix first. If it's quiet, summarize overall service health instead.\",\"subtitle\":\"Find the top production errors and where they start in the code\"},{\"subtitle\":\"Catch up on mentions and threads waiting on a reply\",\"pluginKey\":\"slack\",\"title\":\"Catch up on Slack\",\"prompt\":\"Summarize my unread mentions and the threads where someone is waiting on me. For anything code-related, point me to the relevant part of this repo, and draft a short reply I can edit for the two most urgent ones.\"},{\"subtitle\":\"Review the database schema for performance and security issues\",\"pluginKey\":\"supabase\",\"prompt\":\"Use the connected Supabase project and this repo to review the database design. Explain how the main tables relate, check for missing indexes, risky RLS policies, and schema patterns that could cause bugs or slow queries. Suggest the top three improvements and include the SQL or migration I should review before applying.\",\"title\":\"Review your schema\"}],\"Designer\":[{\"pluginKey\":\"figma\",\"prompt\":\"I want to turn one of my Figma designs into working code. Ask me to paste a link to the frame (or tell me to select it in Figma), then build it faithfully: real layout, real spacing, real text. Show me how to open it in the browser when you're done.\",\"subtitle\":\"Turn a design frame into working, clickable code\",\"title\":\"Design to code\"},{\"prompt\":\"Take the prototype we've been working on and deploy it to Vercel so I get a live URL I can share for feedback. Walk me through any login step, and give me the link when it's up.\",\"pluginKey\":\"vercel\",\"subtitle\":\"Put the prototype at a live link anyone can open\",\"title\":\"Publish a prototype\"},{\"prompt\":\"Take my rough handoff notes and turn them into clear, scoped Linear tickets: what to build, the states and edge cases, and what \\\"done\\\" looks like. I'll paste the notes, or point you at existing tickets to clean up.\",\"title\":\"Notes to tickets\",\"pluginKey\":\"linear\",\"subtitle\":\"Turn handoff notes into tickets engineers can pick up\"},{\"pluginKey\":\"notion\",\"title\":\"Feedback to decisions\",\"prompt\":\"Search my Notion for recent design critique or feedback notes, and turn them into a short decision doc: what was decided, what's still open, and the next steps with owners. Keep it to one page.\",\"subtitle\":\"Turn design feedback into decisions and next steps\"}],\"Data\":[{\"title\":\"Query the warehouse\",\"subtitle\":\"Answer a business question straight from the warehouse\",\"pluginKey\":\"databricks\",\"prompt\":\"I want to answer a question with our warehouse data. Start by listing the schemas and tables so you know what's available, then ask me what question to dig into. Or if you spot an obviously interesting table, propose a question and answer it with a query I can read.\"},{\"title\":\"Chart a question\",\"subtitle\":\"Build a chart from a metric question\",\"pluginKey\":\"hex\",\"prompt\":\"Help me turn a question into a Hex notebook: the query, a clean chart, and one sentence on what it shows. Ask me what question to start with, or propose one based on what's in the workspace.\"},{\"prompt\":\"Turn this analysis into a decision-ready brief. Include the business question, method, key findings, caveats, recommendation, and next steps. Call out any assumptions or limitations that could change the decision.\",\"subtitle\":\"Summarize an analysis into findings and recommendations\",\"pluginKey\":\"notion\",\"title\":\"Write up findings\"},{\"pluginKey\":\"jira\",\"subtitle\":\"Turn a data request into queries and an analysis plan\",\"title\":\"Plan a data request\",\"prompt\":\"Find the data request tickets assigned to me in Jira, pick the top one, and break it into an analysis plan: the clarifying questions I should ask, the tables and queries it needs, and what the deliverable should look like. If nothing's assigned to me, grab a recent request from the team queue.\"}],\"Product Manager\":[{\"pluginKey\":\"jira\",\"prompt\":\"Find active projects in the connected workspace, pick the one with the most recent activity, and draft a one-page product spec from its issues and docs: the problem, requirements, open questions, and anything ambiguous or contradictory. Flag assumptions the project relies on but never states.\",\"subtitle\":\"Draft a product spec from an active project\",\"title\":\"Draft a spec\"},{\"title\":\"Analyze usage\",\"subtitle\":\"Summarize adoption and drop-off for a feature\",\"prompt\":\"Look at recent usage in Amplitude and summarize adoption and drop-off for a feature: who's picking it up, where people fall out of the flow, and how that changed over the last 30 days. Ask me which feature to look at, or if one stands out in the data, start there and tell me why.\",\"pluginKey\":\"amplitude\"},{\"pluginKey\":\"notion\",\"prompt\":\"Search my Notion workspace for customer feedback, research notes, and meeting notes from the last quarter. Synthesize them into ranked themes with rough frequency, and draft a short problem brief for the top theme. Cite which notes each theme came from.\",\"subtitle\":\"Turn scattered feedback into ranked product themes\",\"title\":\"Synthesize feedback\"},{\"title\":\"Prototype a mock\",\"prompt\":\"I want to turn a Figma mock into a clickable prototype I can share. Ask me to paste a link to the frame, then build it as a working page and tell me how to view it in the browser.\",\"pluginKey\":\"figma\",\"subtitle\":\"Turn a mock into a clickable prototype\"}],\"Researcher\":[{\"pluginKey\":\"notion\",\"title\":\"Synthesize readings\",\"subtitle\":\"Synthesize saved readings into themes and findings\",\"prompt\":\"Search my Notion for reading notes and research materials, and synthesize them into a structured summary: the main themes, where sources agree and disagree, and the open questions worth pursuing. Cite which note each claim comes from.\"},{\"prompt\":\"Help me explore a dataset in a Hex notebook: profile what's in it, run the analysis that best answers my question, and produce a publication-clean figure. Ask me which dataset and question to start with.\",\"subtitle\":\"Explore a dataset and chart the key result\",\"pluginKey\":\"hex\",\"title\":\"Explore a dataset\"}],\"Other...\":[{\"prompt\":\"Find the Jira tickets assigned to me, pick the one that best fits this repo, and turn it into a step-by-step implementation plan: the approach, the files to change, and how to test it. If nothing is assigned to me, suggest three small open tickets and recommend one to start with.\",\"subtitle\":\"Pick up a ticket and plan the fix in this repo\",\"pluginKey\":\"jira\",\"title\":\"Plan a ticket\"},{\"pluginKey\":\"datadog\",\"title\":\"Investigate errors\",\"prompt\":\"Pull the most frequent production errors from the last 24 hours, group them by likely root cause, and trace the top one to the code in this repo that throws it. Tell me what you'd check or fix first. If it's quiet, summarize overall service health instead.\",\"subtitle\":\"Find the top production errors and where they start in the code\"},{\"pluginKey\":\"slack\",\"subtitle\":\"Catch up on mentions and threads waiting on a reply\",\"prompt\":\"Summarize my unread mentions and the threads where someone is waiting on me. For anything code-related, point me to the relevant part of this repo, and draft a short reply I can edit for the two most urgent ones.\",\"title\":\"Catch up on Slack\"}],\"Student\":[{\"prompt\":\"Help build a simple web app and deploy it with a real URL to share. Ask what to make, or suggest three fun ideas that could be finished today. Then build it, deploy it, and provide the live link.\",\"title\":\"Build & publish\",\"subtitle\":\"Build a web app and publish it live\",\"pluginKey\":\"vercel\"},{\"subtitle\":\"Debug an error and explain why it happened\",\"pluginKey\":\"context7\",\"prompt\":\"I'll paste an error I'm stuck on (or find one in this project). Fix it using current documentation for the library involved, then explain what actually went wrong in plain language, like a patient tutor. I want to understand it, not just make it go away.\",\"title\":\"Debug an error\"},{\"title\":\"Make a study guide\",\"prompt\":\"Search my Notion for class notes on a topic (ask me which), and turn them into a study guide: the key concepts in plain language, five practice problems from easy to hard, and a plan for the week before the exam.\",\"subtitle\":\"Turn notes into a study guide and practice plan\",\"pluginKey\":\"notion\"}],\"Educator\":[{\"prompt\":\"Help me plan a lesson. Ask me the topic and level, then draft lecture notes, two worked examples, and three exercises with an answer key, saved as a doc I can edit.\",\"title\":\"Plan a lesson\",\"pluginKey\":\"notion\",\"subtitle\":\"Build a lesson plan with examples and exercises\"},{\"prompt\":\"Help me create a programming assignment: ask me the topic and level, then generate starter code, hidden tests, and a rubric, using current library versions so nothing is deprecated by the time students run it.\",\"subtitle\":\"Create an assignment with starter code and tests\",\"title\":\"Create an assignment\",\"pluginKey\":\"context7\"},{\"title\":\"Build a class demo\",\"subtitle\":\"Build a live demo for a class concept\",\"prompt\":\"Help me build a small interactive demo that teaches one concept from my class, and deploy it to a link students can open on their phones. Ask me which concept.\",\"pluginKey\":\"vercel\"}]}},\"is_device_based\":false,\"passed\":false},\"3490881083\":{\"name\":\"3490881083\",\"rule_id\":\"abandoned\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"compass_fast_path_model\":\"\",\"compass_v4_pinned_model\":\"\",\"ui_browser_verification_prompt_enabled\":true,\"table_version\":0,\"tier\":\"\",\"user_cooldown_seconds\":86400,\"sample_fraction\":0,\"classification_model\":\"\",\"enabled\":false,\"cost_limit\":0,\"request_route_fraction\":0,\"sample_rate_denominator\":0,\"routing_strategy\":\"\",\"vega_mxfp8_arm\":\"\",\"routing_models\":\"\",\"taxonomy_type\":\"\",\"model\":\"\",\"randomize_candidates\":false,\"taxonomy\":\"\",\"prompt_variant\":\"\",\"cinderleaf_quantization\":\"\",\"models_in_the_mix\":0,\"classifier_group\":\"\",\"grok_satisfaction_threshold\":0,\"inference_sampling_params\":{},\"compass_model_type\":\"\",\"lower_boundary_for_sending_to_composer\":0,\"margin_needed_for_sending_to_composer\":0,\"compass_v4_lambda\":0,\"combined_algorithm_fallback_taxonomy_type\":\"\",\"context\":\"\"},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"routing_strategy\",\"taxonomy_type\",\"compass_v4_lambda\",\"grok_satisfaction_threshold\",\"randomize_candidates\"],\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3490881084\":{\"name\":\"3490881084\",\"rule_id\":\"abandoned\",\"secondary_exposures\":[],\"id_type\":\"userID\",\"value\":{\"compass_fast_path_model\":\"\",\"compass_v4_pinned_model\":\"\",\"ui_browser_verification_prompt_enabled\":true,\"table_version\":0,\"tier\":\"\",\"user_cooldown_seconds\":86400,\"sample_fraction\":0,\"classification_model\":